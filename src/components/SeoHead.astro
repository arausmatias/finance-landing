---
import { SITE, absoluteUrl, withBase, type Lang } from '../site';

/** Meta, social cards, fonts and structured data shared by every indexable page. */
interface Props {
  title: string;
  description: string;
  /** Site path without base, e.g. "blog/" */
  path: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  lang?: Lang;
  /** Translations of this page, as site paths without base */
  alternates?: { lang: Lang; path: string }[];
}

const { title, description, path, type = 'website', jsonLd = [], publishedTime, modifiedTime, lang = 'es', alternates = [] } = Astro.props;
const htmlLang = lang === 'en' ? 'en' : SITE.locale;
const ogLocale = lang === 'en' ? 'en_US' : SITE.ogLocale;
const hreflang = (l: Lang) => (l === 'en' ? 'en' : 'es');
const canonical = absoluteUrl(path);
const image = absoluteUrl('og.png');
---
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {alternates.length > 0 && <link rel="alternate" hreflang={hreflang(lang)} href={canonical}>}
  {alternates.map((alt) => <link rel="alternate" hreflang={hreflang(alt.lang)} href={absoluteUrl(alt.path)}>)}
  <meta name="theme-color" content="#0E4A34">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml">
  <link rel="sitemap" href={withBase('sitemap-index.xml')}>
  <link rel="alternate" type="application/rss+xml" title={`${SITE.blogName} · ${SITE.name}`} href={withBase('rss.xml')}>

  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:locale" content={ogLocale}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={image}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Loneto: tu plata, anotada en segundos">
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@500;600;700;800&display=swap">
  {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

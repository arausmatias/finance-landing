---
import { getCollection } from 'astro:content';
import Variant from '../../layouts/Variant.astro';
import { sortPosts, formatDate, withBase } from '../../site';

const posts = sortPosts(await getCollection('blog'));
---
<Variant
  title="Loneto · Variante Mix"
  description="Variante de la landing de Loneto que combina la nav de Float, el hero actual y las secciones de Glow en modo claro."
  path="variants/mix/"
  themeColor="#FFFFFF"
  scheme="light"
>
<span class="nav-sentinel" aria-hidden="true"></span>
<header class="nav-wrap" id="navWrap">
  <nav class="nav" aria-label="Principal">
    <a class="logo" href="#top"><svg viewBox="0 0 120 120" aria-hidden="true"><use href="#moni-happy"/></svg>Loneto</a>
    <span class="nav-links">
      <a href="#funciones">Funciones</a>
      <a href="#compartido">Compartido</a>
      <a href="#privacidad">Privacidad</a>
      <a href={withBase('blog/')}>Blog</a>
    </span>
    <a class="nav-cta press" href="#bajar">Cuándo sale</a>
  </nav>
</header>

<main id="top">

<!-- Hero: the live landing's hero, unchanged in content and motion -->
<section class="hero" aria-labelledby="h-hero">
  <div class="hero-body">
    <div class="hero-copy">
      <h1 id="h-hero">Tu plata, anotada <em>en segundos.</em></h1>
      <p class="lead">Cada ingreso y cada gasto, cargado en tres toques. Dividí cuentas con quien quieras y armá el hábito. <strong>Todo queda en tu teléfono.</strong></p>
      <div class="hero-actions">
        <a class="btn-accent press" href="#funciones">Mirá lo que hace</a>
      </div>
      <p class="soon"><svg class="i" aria-hidden="true"><use href="#i-apple"/></svg><svg class="i" aria-hidden="true"><use href="#i-google-play"/></svg>Muy pronto en iPhone y Android</p>
    </div>

    <div class="pile">
      <div class="balance">
        <span class="pile-top"><span class="balance-label">Balance de <span id="month">septiembre</span></span><button class="pause press" id="pause" type="button" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#i-pause" id="pauseIcon"/></svg><span id="pauseText">Pausar</span></button></span>
        <span class="balance-value" id="balance">$ 842.320</span>
        <span class="balance-split"><span><i class="dot" style="background:#74D69B"></i>Ingresos <b id="incomeTotal">$ 1.250.000</b></span><span><i class="dot" style="background:#FF9A8F"></i>Gastos <b id="expenseTotal">$ 407.680</b></span></span>
      </div>
      <p class="sr-only">Animación de ejemplo: ingresos y gastos del mes se apilan uno encima del otro mientras el balance se actualiza.</p>
      <div class="pile-area" id="pileArea" aria-hidden="true">
        <span class="delta" id="delta"></span>
      </div>
      <p class="pile-cap"><svg class="i" aria-hidden="true"><use href="#i-lightning-bolt"/></svg>Cada movimiento, anotado en segundos.</p>
    </div>
  </div>
</section>

<section class="features" id="funciones" aria-labelledby="h-features">
  <div class="features-head">
    <h2 id="h-features">Todo lo que pasa con tu plata. <span>Lo tuyo y lo que compartís, en el mismo lugar.</span></h2>
    <div class="tabs" role="tablist" aria-label="Funciones">
      <button class="press" role="tab" id="tab-you" aria-selected="true" aria-controls="panel-you" type="button">Para vos</button>
      <button class="press" role="tab" id="tab-others" aria-selected="false" aria-controls="panel-others" type="button" tabindex="-1">Con otros</button>
    </div>
  </div>

  <div class="cards" role="tabpanel" id="panel-you" aria-labelledby="tab-you">
    <article class="card" style="--tone:#1F5F9A;--soft:#DCEAF7" id="walletsCard">
      <div class="card-top"><span class="card-ico"><svg class="i" aria-hidden="true"><use href="#i-wallet"/></svg></span><h3>Cuentas y monedas</h3></div>
      <p>Efectivo, banco, tarjeta y billetera virtual, cada una con su moneda. Los pesos y los dólares nunca se mezclan.</p>
      <div class="card-visual">
        <button class="mini-btn press" id="eye" type="button" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#i-eye-outline"/></svg><span id="eyeText">Ocultar montos</span></button>
        <div class="wallets">
          <div class="wallet" style="background:#1F5F9A"><span class="w-ico"><svg class="i" aria-hidden="true"><use href="#i-bank"/></svg></span><span class="w-name">ARS · Banco</span><b class="w-bal"><span>$ 412.650</span><i>••••••</i></b></div>
          <div class="wallet" style="background:#1F7A44"><span class="w-ico"><svg class="i" aria-hidden="true"><use href="#i-wallet"/></svg></span><span class="w-name">ARS · Efectivo</span><b class="w-bal"><span>$ 38.200</span><i>••••••</i></b></div>
          <div class="wallet" style="background:#147369"><span class="w-ico"><svg class="i" aria-hidden="true"><use href="#i-cash"/></svg></span><span class="w-name">USD · Ahorro</span><b class="w-bal"><span>US$ 1.250</span><i>••••••</i></b></div>
        </div>
      </div>
    </article>

    <article class="card" style="--tone:#9E561A;--soft:#FCE8D6">
      <div class="card-top"><span class="card-ico"><svg class="i" aria-hidden="true"><use href="#i-fire"/></svg></span><h3>Racha y niveles</h3></div>
      <p>Una racha, una meta diaria y niveles para que anotar se vuelva costumbre. Nadie te reta por lo que gastás.</p>
      <div class="card-visual habit">
        <div class="habit-top">
          <svg class="moni" viewBox="0 0 120 120" aria-hidden="true"><use href="#moni-happy"/></svg>
          <div class="pills"><span class="pill"><svg class="i fire" aria-hidden="true"><use href="#i-fire"/></svg>Racha de 12 días</span><span class="pill"><svg class="i star" aria-hidden="true"><use href="#i-star-four-points"/></svg>Nivel 4</span></div>
        </div>
        <div class="week" aria-hidden="true" data-reveal="bars">
          <i style="--h:46%"></i><i style="--h:72%"></i><i style="--h:30%"></i><i style="--h:58%"></i><i class="today" style="--h:84%"></i><i class="future" style="--h:10%"></i><i class="future" style="--h:10%"></i>
        </div>
        <div class="days" aria-hidden="true"><span>L</span><span>M</span><span>M</span><span>J</span><span class="today">V</span><span>S</span><span>D</span></div>
      </div>
    </article>

    <article class="card" style="--tone:#147369;--soft:#D5F1EE">
      <div class="card-top"><span class="card-ico"><svg class="i" aria-hidden="true"><use href="#i-weather-night"/></svg></span><h3>De día o de noche</h3></div>
      <p>Tema claro y oscuro, cada uno pensado aparte. En español o en inglés.</p>
      <div class="card-visual theme-demo">
        <div class="theme-seg" role="group" aria-label="Tema de ejemplo">
          <button class="press" type="button" data-theme-pick="day" aria-pressed="true"><svg class="i" aria-hidden="true"><use href="#i-white-balance-sunny"/></svg>Claro</button>
          <button class="press" type="button" data-theme-pick="night" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#i-weather-night"/></svg>Oscuro</button>
        </div>
        <div class="mini-month" id="miniMonth">
          <div class="mm-top"><b>Balance del mes</b><span>Septiembre</span></div>
          <div class="mm-totals"><div><span>Ingresos</span><b class="mm-in">$ 1.250.000</b></div><div><span>Gastos</span><b class="mm-out">$ 812.300</b></div></div>
          <div class="mm-stack"><i style="width:32%;background:var(--mm-green)"></i><i style="width:21%;background:var(--mm-orange)"></i><i style="width:14%;background:var(--mm-blue)"></i><i style="width:12%;background:var(--mm-yellow)"></i><i style="width:21%;background:var(--mm-teal)"></i></div>
          <div class="mm-langs"><span>Español</span><span>English</span></div>
        </div>
      </div>
    </article>
  </div>

  <div class="cards" role="tabpanel" id="panel-others" aria-labelledby="tab-others" hidden>
    <article class="card" style="--tone:#9E561A;--soft:#FCE8D6">
      <div class="card-top"><span class="card-ico"><svg class="i" aria-hidden="true"><use href="#i-silverware-fork-knife"/></svg></span><h3>Dividir la cuenta</h3></div>
      <p>Iguales, por partes, por porcentaje o por importe. La app te dice quién le paga a quién.</p>
      <div class="card-visual split">
        <div class="expense"><span class="badge" style="background:var(--orange-soft);color:var(--orange)"><svg class="i" aria-hidden="true"><use href="#i-silverware-fork-knife"/></svg></span><span class="row-main"><b>Cena en lo de Sofi</b><span>Pagaste vos · 3 personas</span></span><b class="num">$ 48.300</b></div>
        <div class="seg-real" role="group" aria-label="Forma de dividir" id="splitSeg">
          <button class="press" type="button" data-mode="equal" aria-pressed="true">Iguales</button>
          <button class="press" type="button" data-mode="shares" aria-pressed="false">Partes</button>
          <button class="press" type="button" data-mode="percentage" aria-pressed="false">%</button>
          <button class="press" type="button" data-mode="amount" aria-pressed="false">Importe</button>
        </div>
        <ul class="people" id="people">
          <li><span class="avatar" style="background:var(--brand-soft);color:var(--brand)">V</span><span class="row-main"><b>Vos</b><span class="detail">Un tercio</span></span><b class="num" data-share="0">$ 16.100</b></li>
          <li><span class="avatar" style="background:var(--orange-soft);color:var(--orange-ink)">S</span><span class="row-main"><b>Sofi</b><span class="detail">Un tercio</span></span><b class="num" data-share="1">$ 16.100</b></li>
          <li><span class="avatar" style="background:var(--blue-soft);color:var(--blue-ink)">T</span><span class="row-main"><b>Tomi</b><span class="detail">Un tercio</span></span><b class="num" data-share="2">$ 16.100</b></li>
        </ul>
        <p class="owed num" id="owed">Te deben $ 32.200</p>
      </div>
    </article>

    <article class="card" style="--tone:#6B42B0;--soft:#EBE2FA">
      <div class="card-top"><span class="card-ico"><svg class="i" aria-hidden="true"><use href="#i-account-group"/></svg></span><h3>Grupos compartidos</h3></div>
      <p>Compartí un grupo con un código. Cada uno carga lo suyo y todo cambio queda a la vista.</p>
      <div class="card-visual group">
        <div class="invite">
          <div><span class="label">Código de invitación</span><b class="code" id="code">X7K2QP</b><span class="valid">Vale 7 días</span></div>
          <button class="mini-btn press" id="copy" type="button"><svg class="i" aria-hidden="true"><use href="#i-content-copy"/></svg><span id="copyText">Copiar</span></button>
        </div>
        <span class="label">Actividad</span>
        <ul class="activity">
          <li><span class="avatar" style="background:var(--orange-soft);color:var(--orange-ink)">S</span><span>Sofi editó “Cena en lo de Sofi”</span></li>
          <li><span class="avatar" style="background:var(--blue-soft);color:var(--blue-ink)">T</span><span>Tomi borró “Nafta”</span></li>
          <li><span class="avatar" style="background:var(--brand-soft);color:var(--brand)">V</span><span>Editaste “Súper”</span></li>
        </ul>
      </div>
    </article>

    <article class="card" style="--tone:#147369;--soft:#D5F1EE">
      <div class="card-top"><span class="card-ico"><svg class="i" aria-hidden="true"><use href="#i-calendar-refresh"/></svg></span><h3>Lo de todos los meses</h3></div>
      <p>Streaming, alquiler, expensas o la luz: cargalo una vez y cada uno sabe cuánto le toca y cuándo.</p>
      <div class="card-visual recurring">
        <div class="rec-head"><span class="badge" style="background:var(--blue-soft);color:var(--blue)"><svg class="i" aria-hidden="true"><use href="#i-play-box-multiple"/></svg></span><span class="row-main"><b>Streaming en familia</b><span>Vence el día 10 · 4 personas</span></span><b class="num">$ 9.600</b></div>
        <div class="track"><i class="fill" style="--to:.5" data-reveal="fill"></i></div>
        <ul class="people tags">
          <li><span class="avatar" style="background:var(--brand-soft);color:var(--brand)">V</span><b>Vos</b><span class="tag" style="background:var(--brand-soft);color:var(--brand)">Paga la cuenta</span></li>
          <li><span class="avatar" style="background:var(--pink-soft);color:var(--pink-ink)">M</span><b>Mamá</b><span class="tag" style="background:var(--green-soft);color:var(--green-ink)">Pagado</span></li>
          <li><span class="avatar" style="background:var(--purple-soft);color:var(--purple-ink)">J</span><b>Juli</b><span class="tag" style="background:var(--yellow-soft);color:var(--yellow-ink)">Informó que pagó</span></li>
          <li><span class="avatar" style="background:var(--surface-alt);color:var(--muted-2)">N</span><b>Nico</b><span class="tag" style="background:var(--surface-alt);color:var(--muted-2)">Pendiente</span></li>
        </ul>
      </div>
    </article>
  </div>
</section>

<section class="slab-wrap" id="compartido" aria-labelledby="h-rec">
    <div class="slab">
      <svg class="swoosh" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true"><path d="M-80 520 C 220 380, 380 640, 640 430 S 980 120, 1300 210" fill="none" stroke="#86D6AB" stroke-width="64" stroke-linecap="round" opacity="0.9"/></svg>
      <h2 id="h-rec">Lo que pagan todos los meses, <span>compartido.</span></h2>
      <p>Cargalo una vez y cada uno sabe cuánto le toca y cuándo. Cada persona anota solo su parte.</p>
      <ul class="rec-pills" aria-label="Ejemplos">
        <li><svg class="i" aria-hidden="true"><use href="#i-play-box-multiple"/></svg>Streaming</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-home"/></svg>Alquiler</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-home-variant"/></svg>Expensas</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-lightning-bolt"/></svg>Luz</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-wifi"/></svg>Internet</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-music"/></svg>Música</li>
      </ul>
      <div class="rec-card">
        <div class="rec-head"><span class="bd" style="background:#DCEAF7;color:#2F7FC8"><svg class="i" aria-hidden="true"><use href="#i-play-box-multiple"/></svg></span><span><b>Streaming en familia</b><small>Vence el día 10 de cada mes · 4 personas</small></span><b class="num">$ 9.600</b></div>
        <ul class="statuses">
          <li><span class="av" style="background:#DCEBE3;color:#0E4A34">V</span><b>Vos</b><span class="tag" style="background:#DCEBE3;color:#0E4A34">Paga la cuenta</span></li>
          <li><span class="av" style="background:#F9DFE8;color:#B03B61">M</span><b>Mamá</b><span class="tag" style="background:#DDF3E4;color:#1F7A44">Pagado</span></li>
          <li><span class="av" style="background:#EBE2FA;color:#6B42B0">J</span><b>Juli</b><span class="tag" style="background:#FBF1D0;color:#85680A">Informó que pagó</span></li>
          <li><span class="av" style="background:#E8EAE4;color:#4F5953">N</span><b>Nico</b><span class="tag" style="background:#E8EAE4;color:#4F5953">Pendiente</span></li>
        </ul>
      </div>
    </div>
  </section>

<section class="privacy" id="privacidad" aria-labelledby="h-privacy">
  <span class="lock" aria-hidden="true"><svg class="i"><use href="#i-cellphone-lock"/></svg></span>
  <h2 id="h-privacy">Tus datos quedan en tu teléfono.</h2>
  <p class="privacy-lead">Tus cuentas, tus movimientos y tus etiquetas viven en el teléfono. Solo sale lo que decidís compartir.</p>
  <ul class="promises">
    <li><b>Sin crear cuenta</b><span>Para tus finanzas no hace falta. Solo para compartir entrás con Google.</span></li>
    <li><b>Sin conectar el banco</b><span>Nadie te pide claves ni acceso a tus cuentas bancarias.</span></li>
    <li><b>Compartís solo lo que elegís</b><span>Un grupo o un gasto de todos los meses, y nada más que eso.</span></li>
  </ul>
</section>

<section class="window-wrap" aria-label="La app">
    <div class="window">
      <div class="phones" aria-hidden="true">
        <div class="phone p-left">
          <div class="scr">
            <div class="st"><span>9:41</span><i class="bat"></i></div>
            <div class="hd"><b>Hola, Vale</b><span class="spill"><svg class="i"><use href="#i-fire"/></svg>13</span></div>
            <div class="wal"><div style="background:#1F5F9A"><span>ARS · Banco</span><b>$ 412.650</b></div><div style="background:#147369"><span>USD · Ahorro</span><b>US$ 1.250</b></div></div>
            <span class="lb">Cargar rápido</span>
            <div class="ch"><span><svg class="i" style="color:#E0B021"><use href="#i-coffee"/></svg>Café</span><span><svg class="i" style="color:#2F9E5B"><use href="#i-cart"/></svg>Súper</span><span><svg class="i" style="color:#2F7FC8"><use href="#i-bus"/></svg>Colectivo</span></div>
            <span class="lb">Últimos movimientos</span>
            <ul class="rw">
              <li><span class="bd" style="background:#FBF1D0;color:#E0B021"><svg class="i"><use href="#i-coffee"/></svg></span><span><b>Café</b><small>Efectivo</small></span><b class="o">− $ 4.500</b></li>
              <li><span class="bd" style="background:#DCEAF7;color:#2F7FC8"><svg class="i"><use href="#i-bus"/></svg></span><span><b>Colectivo</b><small>Débito</small></span><b class="o">− $ 1.070</b></li>
              <li><span class="bd" style="background:#DDF3E4;color:#2F9E5B"><svg class="i"><use href="#i-briefcase"/></svg></span><span><b>Sueldo</b><small>Banco</small></span><b class="n">+ $ 1.250.000</b></li>
            </ul>
          </div>
        </div>
        <div class="phone p-mid">
          <div class="scr">
            <div class="st"><span>9:41</span><i class="bat"></i></div>
            <div class="hd hd-c"><svg class="i"><use href="#i-chevron-left"/></svg><b>Casa compartida</b><span></span></div>
            <div class="grp-hero"><span>Te deben</span><b>$ 15.000</b><small>3 personas · Compartido</small></div>
            <span class="lb">Cómo saldar</span>
            <ul class="settle"><li><span class="av" style="background:#FCE8D6;color:#9E561A">S</span>Sofi<svg class="i"><use href="#i-arrow-right"/></svg><span class="av" style="background:#DCEBE3;color:#0E4A34">V</span>Vos<b>$ 10.200</b></li><li><span class="av" style="background:#DCEAF7;color:#1F5F9A">T</span>Tomi<svg class="i"><use href="#i-arrow-right"/></svg><span class="av" style="background:#DCEBE3;color:#0E4A34">V</span>Vos<b>$ 4.800</b></li></ul>
            <span class="lb">Gastos</span>
            <ul class="rw">
              <li><span class="bd" style="background:#FCE8D6;color:#E8893A"><svg class="i"><use href="#i-silverware-fork-knife"/></svg></span><span><b>Cena</b><small>Pagaste vos</small></span><b>$ 48.300</b></li>
              <li><span class="bd" style="background:#DDF3E4;color:#2F9E5B"><svg class="i"><use href="#i-cart"/></svg></span><span><b>Súper</b><small>Pagó Sofi</small></span><b>$ 23.100</b></li>
              <li><span class="bd" style="background:#FBF1D0;color:#E0B021"><svg class="i"><use href="#i-lightning-bolt"/></svg></span><span><b>Luz</b><small>Pagó Tomi</small></span><b>$ 28.500</b></li>
            </ul>
          </div>
        </div>
        <div class="phone p-right">
          <div class="scr">
            <div class="st"><span>9:41</span><i class="bat"></i></div>
            <div class="hd hd-c"><svg class="i"><use href="#i-chevron-left"/></svg><b>Nuevo movimiento</b><span></span></div>
            <div class="sg"><span class="on">Gasto</span><span>Ingreso</span><span>Transferencia</span></div>
            <div class="am"><small>ARS</small><b>$ 4.500</b></div>
            <div class="ch"><span class="sel"><svg class="i"><use href="#i-coffee"/></svg>Café</span><span>Súper</span><span>Colectivo</span></div>
            <div class="kp"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>,</span><span>0</span><span><svg class="i"><use href="#i-backspace-outline"/></svg></span></div>
            <span class="sv">Guardar</span>
          </div>
        </div>
      </div>
    </div>
    <p class="window-cap">Inicio, un grupo compartido y el teclado de la app, con datos de ejemplo.</p>
  </section>

<section class="blog" aria-labelledby="h-blog">
  <div class="blog-head"><h2 id="h-blog">Del blog</h2><a href={withBase('blog/')}>Ver todos <svg class="i" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></div>
  <ul class="posts">
    {posts.map((post) => (
      <li><a class="post" href={withBase(`blog/${post.id}/`)}>
        <span class="post-disc" style={`background:var(--${post.data.tone})`}><svg class="i" aria-hidden="true"><use href={`#i-${post.data.icon}`} /></svg></span>
        <span class="post-main"><b>{post.data.title}</b><span>{post.data.description}</span></span>
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
      </a></li>
    ))}
  </ul>
</section>

<section class="close" id="bajar" aria-labelledby="h-close">
  <svg class="close-moni" viewBox="0 0 120 120" aria-hidden="true"><use href="#moni-wow"/></svg>
  <h2 id="h-close">Anotá hoy. Mañana ya es costumbre.</h2>
  <p>Loneto llega pronto a iPhone y Android, en español y en inglés.</p>
  <div class="stores">
    <span class="store"><svg class="i" aria-hidden="true"><use href="#i-apple"/></svg><span><small>Próximamente</small><b>App Store</b></span></span>
    <span class="store"><svg class="i" aria-hidden="true"><use href="#i-google-play"/></svg><span><small>Próximamente</small><b>Google Play</b></span></span>
  </div>
</section>
</main>

<footer class="foot">
  <nav aria-label="Pie de página"><a href={withBase('')}>Loneto</a><a href={withBase('blog/')}>Blog</a><a href={withBase('variants/')}>Variantes</a></nav>
  <p>Los montos, nombres y cuentas de esta página son de ejemplo.</p>
</footer>

<style is:global>
:root {
  --page: #FFFFFF; --canvas: #F1F2EE; --surface: #FFFFFF; --surface-alt: #E8EAE4; --line: #E3E5E0; --line-2: #C9CDC6;
  --text: #17201B; --muted: #66706A; --muted-2: #4F5953;
  --brand: #0E4A34; --brand-soft: #DCEBE3; --hero: #0E4A34; --on-hero-muted: #9FC2B1;
  --forest: #0E4A34; --forest-deep: #093324; --on-forest-muted: #B5D3C4; --panel: #F1F2EE; --panel-2: #E8EAE4;
  --accent: #B6EB7D; --on-accent: #0E4A34; --tile: #FFFFFF;
  --income-text: #1F7A44; --expense-text: #B8433A;
  --green: #2F9E5B; --green-soft: #DDF3E4; --green-ink: #1F7A44;
  --blue: #2F7FC8; --blue-soft: #DCEAF7; --blue-ink: #1F5F9A;
  --red: #E05A4F; --red-soft: #FBE1DD; --red-ink: #B8433A;
  --orange: #E8893A; --orange-soft: #FCE8D6; --orange-ink: #9E561A;
  --yellow: #E0B021; --yellow-soft: #FBF1D0; --yellow-ink: #85680A;
  --purple: #8B5CD6; --purple-soft: #EBE2FA; --purple-ink: #6B42B0;
  --pink: #D6517A; --pink-soft: #F9DFE8; --pink-ink: #B03B61;
  --teal: #1FA396; --teal-soft: #D5F1EE; --teal-ink: #147369;
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --font: "Figtree", ui-rounded, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scrollbar-color: var(--line-2) var(--page); }
body { margin: 0; background: var(--page); color: var(--text); font-family: var(--font); font-weight: 500; font-size: 17px; line-height: 1.55; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
::selection { background: var(--accent); color: var(--brand); }
:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; border-radius: 12px; }
.hero :focus-visible { outline-color: var(--accent); }
h1, h2, h3, p, ul, ol { margin: 0; }
ul, ol { padding: 0; list-style: none; }
a { color: inherit; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
[hidden] { display: none !important; }
.i { width: 20px; height: 20px; fill: currentColor; flex: none; }
.num { font-variant-numeric: tabular-nums; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.press { transition: transform 160ms var(--ease), opacity 160ms var(--ease), background-color 160ms, color 160ms, border-color 160ms, box-shadow 160ms; }
.press:active { transform: scale(0.97); opacity: 0.9; }
main { overflow-x: clip; }

/* ---------- Nav (from Float): becomes a floating pill once you scroll ---------- */
.nav-sentinel { position: absolute; top: 0; height: 24px; width: 1px; }
.nav-wrap { position: sticky; top: 0; z-index: 50; padding: 0 16px; }
.nav { max-width: 1160px; margin: 0 auto; height: 68px; padding: 0 12px 0 20px; display: flex; align-items: center; gap: 24px; border-radius: 999px; border: 1px solid transparent; transition: transform 300ms var(--ease), background-color 300ms, box-shadow 300ms, border-color 300ms; }
.floating .nav { transform: translateY(12px); background: rgba(255, 255, 255, 0.86); border-color: var(--line); box-shadow: 0 10px 30px rgba(16, 32, 24, 0.12); backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3); }
.logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 21px; letter-spacing: -0.02em; text-decoration: none; }
.logo svg { width: 32px; height: 32px; }
.nav-links { display: flex; gap: 32px; margin-inline: auto; font-size: 16px; font-weight: 600; }
.nav-links a { text-decoration: none; color: var(--muted-2); transition: color 160ms; }
.nav-links a:hover { color: var(--text); }
.nav-cta { height: 46px; padding: 0 22px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--brand); color: #FFFFFF; font-weight: 700; font-size: 15.5px; text-decoration: none; }
.nav-cta:hover { background: #135A40; }
@media (max-width: 760px) { .nav-links { display: none; } .nav-cta { margin-left: auto; } }

/* ---------- Hero (the live landing's): forest canopy with the pile ---------- */
.hero { max-width: 1240px; margin: 8px auto 0; border-radius: 40px; background: var(--hero); color: #FFFFFF; overflow: hidden; }
.hero-body { display: grid; gap: 16px; padding: 36px 24px 40px; }
.hero-copy { display: contents; }
.hero h1 { order: 1; } .lead { order: 2; } .pile { order: 3; } .hero-actions { order: 4; } .soon { order: 5; }
.hero h1 { font-size: clamp(42px, 7.6vw, 88px); line-height: 1; font-weight: 800; letter-spacing: -0.035em; max-width: 11ch; text-wrap: balance; }
.hero h1 em { font-style: normal; }
.lead { color: var(--on-hero-muted); font-size: 18px; line-height: 1.45; font-weight: 600; max-width: 36ch; }
.lead strong { color: #FFFFFF; font-weight: 700; }
.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding-top: 4px; }
.btn-accent { display: inline-flex; align-items: center; min-height: 56px; padding-inline: 24px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-size: 17px; font-weight: 700; text-decoration: none; white-space: nowrap; }
.btn-accent:hover { background: #C4F190; }
.soon { display: flex; align-items: center; gap: 8px; color: var(--on-hero-muted); font-size: 14px; font-weight: 600; }
.soon .i { width: 18px; height: 18px; }
.pile { display: grid; gap: 14px; align-content: start; }
.balance { display: grid; gap: 2px; }
.pile-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.balance-label { font-size: 14px; font-weight: 700; color: var(--on-hero-muted); }
.balance-value { font-size: clamp(34px, 5vw, 44px); line-height: 1.05; font-weight: 800; letter-spacing: -0.8px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.balance-split { display: flex; gap: 14px; flex-wrap: wrap; font-size: 13.5px; color: var(--on-hero-muted); font-weight: 600; }
.balance-split b { color: #FFFFFF; font-weight: 700; font-variant-numeric: tabular-nums; }
.dot { display: inline-block; width: 8px; height: 8px; border-radius: 999px; margin-right: 6px; vertical-align: 1px; }
.pause { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding-inline: 14px; border-radius: 999px; border: 1.5px solid rgba(255, 255, 255, 0.35); color: #FFFFFF; font-size: 14px; font-weight: 700; }
.pause .i { width: 18px; height: 18px; }
.pause:hover { background: rgba(255, 255, 255, 0.08); }
.pile-area { position: relative; height: 300px; }
.tile {
  position: absolute; left: 0; right: 0; bottom: 0; min-height: 64px; border-radius: 18px; background: var(--tile); color: #17201B;
  display: flex; align-items: center; gap: 12px; padding: 10px 14px; box-shadow: 0 8px 22px rgba(4, 24, 16, 0.28);
  transform-origin: 50% 100%; transition: transform 700ms var(--ease), opacity 450ms var(--ease), filter 450ms var(--ease);
}
.tile .badge { width: 40px; height: 40px; }
.tile .row-main b { font-size: 16px; }
.tile .row-main span { color: #5B655F; font-size: 13px; }
.tile .amt { font-size: 16.5px; }
.tile .amt.in { color: #1A6B3B; }
.tile .amt.out { color: #B8433A; }
.delta { position: absolute; right: 0; top: -6px; pointer-events: none; display: inline-flex; align-items: center; min-height: 30px; padding-inline: 12px; border-radius: 999px; background: var(--tile); font-size: 14px; font-weight: 800; font-variant-numeric: tabular-nums; opacity: 0; transform: translateY(8px); }
.delta.in { color: #1A6B3B; }
.delta.out { color: #B8433A; }
.pile-cap { display: flex; align-items: center; gap: 8px; color: var(--on-hero-muted); font-size: 14px; font-weight: 600; }
.pile-cap .i { width: 18px; height: 18px; color: #FFFFFF; }
@media (min-width: 720px) { .pile-area { height: 340px; } .hero-body { padding: 48px 40px 56px; } }
@media (min-width: 1040px) {
  .hero-body { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 56px; padding: 72px 64px 80px; }
  .hero-copy { display: grid; gap: 16px; align-content: start; }
  .pile-area { height: 400px; }
}

/* Shared app atoms */
.badge { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; flex: none; }
.badge .i { width: 18px; height: 18px; }
.row-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.row-main b { font-weight: 700; }
.row-main span { color: var(--muted); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.amt { font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }

/* ---------- The app window (from Float) ---------- */
.window-wrap { padding: 150px 16px 0; }
.window { max-width: 1160px; margin: 0 auto; border-radius: 40px; background: var(--panel); border: 1px solid var(--line); padding: 64px 32px 0; overflow: hidden; box-shadow: 0 50px 100px -40px rgba(16, 32, 24, 0.28); }
.phones { display: flex; justify-content: center; align-items: flex-end; gap: 28px; }
.phone { flex: none; width: 290px; border-radius: 46px 46px 0 0; padding: 10px 10px 0; background: #17201B; box-shadow: 0 30px 60px -20px rgba(16, 32, 24, 0.35); }
.p-mid { width: 310px; position: relative; z-index: 1; }
.p-left, .p-right { margin-bottom: -60px; }
.scr { height: 560px; border-radius: 37px 37px 0 0; background: #F1F2EE; overflow: hidden; padding: 0 14px; font-size: 12.5px; line-height: 1.3; display: flex; flex-direction: column; gap: 8px; }
.p-mid .scr { height: 600px; }
.st { height: 36px; flex: none; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; font-weight: 700; font-size: 13px; }
.bat { width: 20px; height: 10px; border-radius: 3px; border: 1.5px solid currentColor; position: relative; }
.bat::after { content: ""; position: absolute; inset: 1.5px 4px 1.5px 1.5px; background: currentColor; border-radius: 1px; }
.hd { display: flex; align-items: center; justify-content: space-between; }
.hd b { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
.hd-c { display: grid; grid-template-columns: 22px 1fr 22px; text-align: center; }
.hd-c b { font-size: 14.5px; font-weight: 700; letter-spacing: 0; }
.hd-c .i { width: 22px; height: 22px; }
.spill { height: 30px; padding: 0 10px; display: inline-flex; align-items: center; gap: 3px; border-radius: 999px; background: #FFFFFF; font-weight: 700; color: var(--text); }
.spill .i { width: 16px; height: 16px; color: var(--orange); }
.wal { display: flex; gap: 8px; margin-right: -14px; }
.wal div { flex: none; width: 140px; height: 92px; border-radius: 18px; padding: 12px; color: #FFFFFF; display: flex; flex-direction: column; justify-content: flex-end; }
.wal span { font-size: 11px; color: rgba(255, 255, 255, 0.86); }
.wal b { font-size: 16px; font-weight: 800; }
.lb { margin-top: 6px; font-size: 13px; font-weight: 700; }
.ch { display: flex; gap: 6px; overflow: hidden; }
.ch span { height: 30px; padding: 0 10px; display: inline-flex; align-items: center; gap: 4px; flex: none; border-radius: 999px; background: #FFFFFF; border: 1px solid var(--line); font-size: 12px; font-weight: 600; }
.ch .i { width: 14px; height: 14px; }
.ch .sel { background: var(--forest); border-color: var(--forest); color: #FFFFFF; }
.rw { display: flex; flex-direction: column; gap: 6px; }
.rw li { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 8px; border-radius: 14px; background: #FFFFFF; }
.rw small { display: block; color: var(--muted); font-size: 11px; }
.rw b { font-weight: 700; font-variant-numeric: tabular-nums; }
.rw .o { color: #B8433A; font-weight: 800; }
.rw .n { color: #1F7A44; font-weight: 800; }
.bd { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; flex: none; }
.bd .i { width: 16px; height: 16px; }
.grp-hero { background: var(--forest); color: #FFFFFF; border-radius: 22px; padding: 16px; display: flex; flex-direction: column; }
.grp-hero span, .grp-hero small { color: #9FC2B1; font-size: 12px; }
.grp-hero b { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
.settle { display: flex; flex-direction: column; gap: 6px; }
.settle li { display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-radius: 14px; background: #FFFFFF; font-weight: 600; }
.settle .i { width: 14px; height: 14px; color: var(--muted); }
.settle b { margin-left: auto; font-weight: 800; font-variant-numeric: tabular-nums; }
.av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 11.5px; flex: none; }
.sg { display: grid; grid-template-columns: repeat(3, 1fr); padding: 3px; border-radius: 999px; background: var(--panel-2); text-align: center; font-size: 11.5px; font-weight: 600; color: var(--muted); }
.sg span { height: 28px; display: grid; place-items: center; border-radius: 999px; }
.sg .on { background: #F1A094; color: var(--forest-deep); font-weight: 700; }
.am { display: flex; align-items: baseline; justify-content: center; gap: 8px; padding: 14px 0 6px; }
.am small { color: var(--muted); font-weight: 700; }
.am b { font-size: 38px; font-weight: 800; color: var(--red); letter-spacing: -0.02em; }
.kp { margin-top: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.kp span { height: 44px; border-radius: 14px; background: #FFFFFF; display: grid; place-items: center; font-size: 18px; font-weight: 700; }
.kp .i { width: 20px; height: 20px; color: var(--muted); }
.sv { margin: 6px 0 60px; height: 44px; border-radius: 999px; display: grid; place-items: center; background: var(--forest); color: #FFFFFF; font-weight: 700; }
.window-cap { margin-top: 18px; text-align: center; color: var(--muted); font-size: 14.5px; }

/* ---------- Feature cards (from Glow, by day) ---------- */
.features { max-width: 1160px; margin: 0 auto; padding: 140px 16px 0; scroll-margin-top: 70px; }
.features-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px 40px; flex-wrap: wrap; margin-bottom: 40px; }
.features h2, .privacy h2, .close h2 { font-size: clamp(30px, 4vw, 48px); line-height: 1.05; font-weight: 800; letter-spacing: -0.03em; text-wrap: balance; }
.features h2 { max-width: 19em; }
.features h2 span { color: var(--muted); }
.tabs { display: flex; gap: 4px; padding: 5px; border-radius: 999px; background: var(--canvas); border: 1px solid var(--line); }
.tabs button { height: 42px; padding: 0 20px; border-radius: 999px; font-weight: 700; font-size: 15px; color: var(--muted-2); }
.tabs button:hover { color: var(--text); }
.tabs [aria-selected="true"] { background: var(--surface); color: var(--brand); box-shadow: 0 1px 3px rgba(16, 32, 24, 0.12); }
.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
.cards:not([hidden]) { animation: panelin 500ms var(--ease); }
@keyframes panelin { from { opacity: 0; transform: translateY(12px); } }
.card { position: relative; display: flex; flex-direction: column; border-radius: 28px; padding: 26px; overflow: hidden; background: var(--soft); }
.card-top { display: flex; align-items: center; gap: 14px; min-height: 44px; }
.card-ico { width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; flex: none; background: var(--tone); color: #FFFFFF; box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--tone) 60%, transparent); }
.card h3 { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
.card > p { margin-top: 18px; padding-bottom: 22px; border-bottom: 1px solid color-mix(in srgb, var(--tone) 16%, transparent); color: var(--muted-2); font-size: 15.5px; line-height: 1.5; }
.card-visual { margin-top: 24px; min-height: 270px; display: flex; flex-direction: column; justify-content: center; gap: 12px; font-size: 14px; }
.mini-btn { align-self: flex-end; height: 36px; padding: 0 12px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 13.5px; font-weight: 700; }
.mini-btn:hover { background: var(--canvas); }
.mini-btn .i { width: 16px; height: 16px; }

.wallets { position: relative; height: 214px; }
.wallet { position: absolute; left: 0; right: 0; height: 116px; border-radius: 20px; padding: 14px 16px; color: #FFFFFF; display: flex; align-items: flex-start; gap: 10px; box-shadow: 0 -8px 20px rgba(16, 32, 24, 0.16); transition: transform 500ms var(--ease); }
.wallet:nth-child(1) { top: 0; }
.wallet:nth-child(2) { top: 49px; }
.wallet:nth-child(3) { top: 98px; box-shadow: 0 -8px 20px rgba(16, 32, 24, 0.16), 0 18px 30px -16px rgba(16, 32, 24, 0.45); }
.card:hover .wallet:nth-child(1) { transform: translateY(-8px); }
.card:hover .wallet:nth-child(3) { transform: translateY(8px); }
.w-ico { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; flex: none; background: rgba(255, 255, 255, 0.2); }
.w-ico .i { width: 16px; height: 16px; }
.w-name { font-size: 14px; line-height: 30px; font-weight: 600; color: rgba(255, 255, 255, 0.9); }
.w-bal { margin-left: auto; line-height: 30px; font-size: 18px; font-weight: 800; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
.w-bal i { display: none; font-style: normal; letter-spacing: 0.1em; }
.hide-amounts .w-bal span { display: none; }
.hide-amounts .w-bal i { display: inline; }

.habit-top { display: flex; align-items: center; gap: 16px; }
.moni { width: 84px; height: 84px; flex: none; filter: drop-shadow(0 10px 14px rgba(16, 32, 24, 0.18)); }
.pills { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
.pill { height: 36px; padding: 0 14px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-weight: 700; font-size: 14px; }
.pill .i { width: 18px; height: 18px; }
.fire { color: var(--orange); }
.star { color: var(--yellow); }
.week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; height: 104px; align-items: end; margin-top: 8px; }
.week i { display: block; height: var(--h); border-radius: 8px; background: #F3D3B5; transform-origin: bottom; }
.week i.today { background: var(--orange-ink); }
.week i.future { background: var(--surface-alt); }
.days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center; color: var(--muted); font-size: 12.5px; font-weight: 700; }
.days .today { color: var(--orange-ink); }

.theme-seg { align-self: center; display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); }
.theme-seg button { height: 36px; padding: 0 14px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; font-size: 13.5px; font-weight: 700; color: var(--muted-2); }
.theme-seg button .i { width: 16px; height: 16px; }
.theme-seg [aria-pressed="true"] { background: var(--teal-soft); color: var(--teal-ink); }
.mini-month {
  --mm-bg: #FFFFFF; --mm-text: #17201B; --mm-muted: #66706A; --mm-line: #E3E5E0; --mm-in: #1F7A44; --mm-out: #B8433A;
  --mm-green: #2F9E5B; --mm-orange: #E8893A; --mm-blue: #2F7FC8; --mm-yellow: #E0B021; --mm-teal: #1FA396;
  background: var(--mm-bg); color: var(--mm-text); border: 1px solid var(--mm-line); border-radius: 22px; padding: 16px; display: flex; flex-direction: column; gap: 12px;
  box-shadow: 0 14px 30px -18px rgba(16, 32, 24, 0.4);
  transition: background-color 400ms var(--ease), color 400ms, border-color 400ms;
}
.mini-month.night { --mm-bg: #151D19; --mm-text: #E8EFEA; --mm-muted: #A3AEA7; --mm-line: #33403A; --mm-in: #74D69B; --mm-out: #FF9A8F; --mm-green: #44B872; --mm-orange: #EE9A52; --mm-blue: #4C95DE; --mm-yellow: #E6BC3A; --mm-teal: #2DBAAB; }
.mm-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; }
.mm-top span, .mm-totals span { color: var(--mm-muted); font-size: 12.5px; }
.mm-totals { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.mm-totals span { display: block; }
.mm-totals b { font-size: 18px; font-weight: 800; font-variant-numeric: tabular-nums; }
.mm-in { color: var(--mm-in); }
.mm-out { color: var(--mm-out); }
.mm-stack { display: flex; height: 10px; border-radius: 999px; overflow: hidden; gap: 2px; }
.mm-stack i { display: block; transition: background-color 400ms; }
.mm-langs { display: flex; gap: 6px; }
.mm-langs span { height: 28px; padding: 0 10px; display: inline-flex; align-items: center; border-radius: 999px; border: 1px solid var(--mm-line); font-size: 12px; font-weight: 700; color: var(--mm-muted); transition: border-color 400ms, color 400ms; }

.expense, .rec-head { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 10px 12px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); }
.expense .num, .rec-head .num { font-weight: 800; }
.seg-real { display: grid; grid-template-columns: repeat(4, 1fr); padding: 4px; border-radius: 999px; background: var(--surface-alt); }
.seg-real button { height: 34px; border-radius: 999px; font-size: 13px; font-weight: 700; color: var(--muted-2); }
.seg-real [aria-pressed="true"] { background: var(--surface); color: var(--brand); box-shadow: 0 1px 3px rgba(16, 32, 24, 0.12); }
.people { display: flex; flex-direction: column; gap: 6px; }
.people li { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 10px; align-items: center; }
.avatar { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 13px; flex: none; }
.people .num { font-weight: 800; }
.owed { align-self: flex-start; height: 30px; padding: 0 12px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--green-soft); color: var(--green-ink); font-size: 13px; font-weight: 700; }

.invite { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 18px; background: var(--surface); border: 1px dashed var(--line-2); }
.invite .mini-btn { align-self: center; margin-left: auto; }
.label { display: block; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
.code { display: block; font-size: 28px; font-weight: 800; letter-spacing: 0.14em; line-height: 1.2; color: var(--purple-ink); font-variant-numeric: tabular-nums; }
.valid { color: var(--muted); font-size: 12.5px; }
.activity { display: flex; flex-direction: column; gap: 8px; }
.activity li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: center; color: var(--muted-2); font-size: 13.5px; font-weight: 600; }
.activity .avatar { width: 28px; height: 28px; font-size: 12px; }
.tags li { grid-template-columns: 32px minmax(0, 1fr) auto; }
.tag { height: 26px; padding: 0 10px; display: inline-flex; align-items: center; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; }
.track { height: 8px; border-radius: 999px; background: var(--surface-alt); overflow: hidden; }
.track .fill { display: block; height: 100%; border-radius: inherit; background: var(--teal-ink); transform-origin: left; transform: scaleX(var(--to, 0)); }

/* ---------- Forest slab (from Float) ---------- */
.slab-wrap { padding: 150px 16px 0; scroll-margin-top: 40px; }
.slab { position: relative; max-width: 1240px; margin: 0 auto; border-radius: 44px; background: var(--forest); color: #FFFFFF; padding: 104px 48px 72px; text-align: center; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; align-items: center; }
.swoosh { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
.slab h2 { font-size: clamp(36px, 5vw, 68px); line-height: 1.02; font-weight: 500; letter-spacing: -0.035em; max-width: 13em; text-wrap: balance; }
.slab h2 span { font-weight: 800; letter-spacing: -0.04em; }
.slab > p { margin-top: 20px; max-width: 32em; color: var(--on-forest-muted); font-size: 18px; }
.rec-pills { margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 760px; }
.rec-pills li { height: 52px; padding: 0 20px; display: inline-flex; align-items: center; gap: 8px; border-radius: 18px; background: #FFFFFF; color: var(--text); font-weight: 700; font-size: 16px; box-shadow: 0 14px 26px -14px rgba(0, 0, 0, 0.5); }
.rec-pills .i { color: var(--forest); }
.rec-card { margin-top: 48px; width: min(560px, 100%); padding: 16px; border-radius: 28px; background: #F1F2EE; color: var(--text); text-align: left; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.55); }
.rec-card .rec-head { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px; border-radius: 18px; background: #FFFFFF; }
.rec-card .rec-head .bd { width: 40px; height: 40px; }
.rec-card .rec-head small { display: block; color: var(--muted); font-size: 13px; }
.rec-card .rec-head .num { font-weight: 800; font-size: 18px; }
.rec-card .statuses { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.rec-card .statuses li { display: grid; grid-template-columns: 28px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 10px; row-gap: 4px; align-items: center; padding: 10px 12px; border-radius: 16px; background: #FFFFFF; }
.rec-card .statuses .av { width: 28px; height: 28px; grid-row: span 2; }
.rec-card .statuses b { font-size: 14.5px; }
.rec-card .tag { justify-self: start; height: 24px; padding: 0 9px; display: inline-flex; align-items: center; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; }

/* ---------- Privacy (from Glow, by day) ---------- */
.privacy { max-width: 1160px; margin: 0 auto; padding: 150px 16px 0; text-align: center; display: flex; flex-direction: column; align-items: center; scroll-margin-top: 60px; }
.lock { width: 84px; height: 84px; border-radius: 26px; display: grid; place-items: center; background: var(--brand); color: #FFFFFF; box-shadow: 0 20px 44px -14px rgba(14, 74, 52, 0.6); margin-bottom: 28px; }
.lock .i { width: 40px; height: 40px; }
.privacy-lead { margin-top: 18px; max-width: 34em; color: var(--muted-2); font-size: 18px; text-wrap: pretty; }
.promises { margin-top: 56px; width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
.promises li { padding: 28px 28px 0; display: flex; flex-direction: column; gap: 6px; text-align: left; }
.promises li + li { border-left: 1px solid var(--line); }
.promises b { font-size: 18px; font-weight: 700; }
.promises span { color: var(--muted); font-size: 15.5px; }

/* ---------- Blog (from Float) ---------- */
.blog { max-width: 1160px; margin: 0 auto; padding: 150px 16px 0; }
.blog-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
.blog h2 { font-size: 30px; font-weight: 800; letter-spacing: -0.03em; }
.blog-head a { display: inline-flex; align-items: center; gap: 6px; color: var(--brand); font-weight: 700; text-decoration: none; }
.blog-head a:hover { text-decoration: underline; text-underline-offset: 4px; }
.blog-head .i { width: 18px; height: 18px; }
.posts li { border-top: 1px solid var(--line); }
.post { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 20px; align-items: center; padding: 24px 0; text-decoration: none; }
.post-disc { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: #17201B; transition: transform 300ms var(--ease); }
.post-disc .i { width: 26px; height: 26px; }
.post:hover .post-disc { transform: scale(1.08) rotate(-6deg); }
.post-main { display: flex; flex-direction: column; gap: 4px; }
.post-main b { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
.post:hover .post-main b { color: var(--brand); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
.post-main span { color: var(--muted); font-size: 15.5px; max-width: 64ch; }
.post time { color: var(--muted); font-size: 14px; font-weight: 600; white-space: nowrap; }

/* ---------- Close and footer (from Glow, by day) ---------- */
.close { position: relative; max-width: 1160px; margin: 150px auto 0; padding: 96px 16px 104px; text-align: center; display: flex; flex-direction: column; align-items: center; overflow: hidden; border-radius: 32px; background: var(--canvas); }
.close-moni { width: 112px; height: 112px; margin-bottom: 24px; filter: drop-shadow(0 18px 24px rgba(16, 32, 24, 0.2)); }
.close p { margin-top: 14px; color: var(--muted-2); font-size: 18px; }
.stores { margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
.store { height: 58px; padding: 0 20px 0 16px; display: inline-flex; align-items: center; gap: 12px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); text-align: left; box-shadow: 0 1px 3px rgba(16, 32, 24, 0.06); }
.store .i { width: 26px; height: 26px; }
.store small { display: block; color: var(--muted); font-size: 12px; font-weight: 600; }
.store b { font-size: 17px; font-weight: 700; line-height: 1.1; }
.foot { max-width: 1160px; margin: 0 auto; padding: 48px 16px 56px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: var(--muted); font-size: 14px; }
.foot nav { display: flex; gap: 20px; }
.foot a { text-decoration: none; font-weight: 700; color: var(--muted-2); }
.foot a:hover { color: var(--text); }

/* ---------- Responsive ---------- */
@media (max-width: 1100px) { .p-left, .p-right { display: none; } }
@media (max-width: 1080px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 1272px) { .hero { margin-inline: 16px; } }
@media (max-width: 760px) {
  .hero { border-radius: 32px; margin-inline: 12px; }
  .features, .privacy, .blog, .slab-wrap { padding-top: 104px; }
  .window-wrap { padding-top: 104px; }
  .window { padding: 40px 16px 0; border-radius: 32px; }
  .p-mid { width: min(300px, 100%); }
  .slab { padding: 72px 20px 24px; border-radius: 32px; }
  .rec-pills li { height: 44px; padding: 0 14px; font-size: 14.5px; border-radius: 14px; }
  .cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-inline: -16px; padding: 0 16px 8px; scrollbar-width: none; }
  .cards::-webkit-scrollbar { display: none; }
  .card { flex: 0 0 min(86vw, 360px); scroll-snap-align: center; padding: 22px; }
  .promises { grid-template-columns: minmax(0, 1fr); }
  .promises li { padding: 22px 4px 0; }
  .promises li + li { border-left: 0; border-top: 1px solid var(--line); margin-top: 22px; }
  .post { grid-template-columns: 48px minmax(0, 1fr); gap: 16px; }
  .post-disc { width: 48px; height: 48px; }
  .post time { grid-column: 2; }
  .close { margin: 104px 12px 0; padding: 72px 16px 80px; border-radius: 28px; }
}
@media (max-width: 420px) { .rec-card .statuses { grid-template-columns: minmax(0, 1fr); } }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .press:active { transform: none; }
  .tile { transition: opacity 400ms ease; }
  .cards:not([hidden]) { animation: none; }
  .wallet, .mini-month, .nav { transition: none; }
}
</style>

<script is:inline>
(() => {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
  const money = (v) => (v < 0 ? '−$ ' : '$ ') + fmt.format(Math.abs(Math.round(v)));
  const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';

  /* Tween a number inside an element; jumps straight to the value under reduced motion. */
  const tweens = new WeakMap();
  function tweenNumber(el, from, to, format, duration = 650) {
    cancelAnimationFrame(tweens.get(el));
    if (reduceMotion.matches || from === to) { el.textContent = format(to); return; }
    const start = performance.now();
    const step = (now) => {
      const t = Math.min(1, (now - start) / duration);
      el.textContent = format(from + (to - from) * (1 - Math.pow(1 - t, 4)));
      if (t < 1) tweens.set(el, requestAnimationFrame(step));
    };
    tweens.set(el, requestAnimationFrame(step));
  }

  /* ---------- Nav turns into a floating pill once the page leaves the top ---------- */
  const navWrap = document.getElementById('navWrap');
  new IntersectionObserver(([e]) => navWrap.classList.toggle('floating', !e.isIntersecting)).observe(document.querySelector('.nav-sentinel'));

  /* ---------- The pile (same as the live landing) ---------- */
  const TONES = {
    green: ['#DDF3E4', '#2F9E5B'], purple: ['#EBE2FA', '#8B5CD6'], yellow: ['#FBF1D0', '#E0B021'],
    blue: ['#DCEAF7', '#2F7FC8'], orange: ['#FCE8D6', '#E8893A'], teal: ['#D5F1EE', '#1FA396'],
    red: ['#FBE1DD', '#E05A4F'], pink: ['#F9DFE8', '#D6517A'],
  };
  const MONTH_ENTRIES = [
    { title: 'Sueldo', meta: 'Banco', icon: 'briefcase', tone: 'green', value: 1250000 },
    { title: 'Alquiler', meta: 'Transferencia', icon: 'home', tone: 'purple', value: -380000 },
    { title: 'Súper', meta: 'Débito', icon: 'cart', tone: 'green', value: -23180 },
    { title: 'Café', meta: 'Efectivo', icon: 'coffee', tone: 'yellow', value: -4500 },
    { title: 'Freelance', meta: 'Billetera virtual', icon: 'laptop', tone: 'blue', value: 180000 },
    { title: 'Colectivo', meta: 'Débito', icon: 'bus', tone: 'blue', value: -1070 },
    { title: 'Luz y gas', meta: 'Tu parte · Compartido', icon: 'lightning-bolt', tone: 'yellow', value: -28400 },
    { title: 'Cena con amigos', meta: 'Tu parte · Grupo', icon: 'silverware-fork-knife', tone: 'orange', value: -16100 },
    { title: 'Reintegro', meta: 'Tarjeta de crédito', icon: 'cash-refund', tone: 'teal', value: 6300 },
    { title: 'Nafta', meta: 'Crédito', icon: 'gas-station', tone: 'red', value: -42000 },
    { title: 'Streaming', meta: 'Tu parte · Recurrente', icon: 'play-box-multiple', tone: 'blue', value: -2400 },
    { title: 'Regalo', meta: 'Efectivo', icon: 'gift', tone: 'pink', value: -15000 },
  ];
  const MONTHS = ['septiembre', 'octubre', 'noviembre', 'diciembre', 'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto'];
  const TILT = [0, -1.2, 1, -0.7, 1.3, -1, 0.6];
  const DECK_GAP = 6;
  const DECK_MAX = 6;
  const INTERVAL = 1700;

  const area = document.getElementById('pileArea');
  const balanceEl = document.getElementById('balance');
  const incomeEl = document.getElementById('incomeTotal');
  const expenseEl = document.getElementById('expenseTotal');
  const monthEl = document.getElementById('month');
  const deltaEl = document.getElementById('delta');
  const pauseBtn = document.getElementById('pause');

  let tiles = []; // newest first: { el, tilt }
  let cursor = 0;
  let monthIndex = 0;
  let totals = { income: 0, expense: 0 };
  let timer = null;
  let userPaused = false;
  let onScreen = true;

  function tileMarkup(entry) {
    const [soft, base] = TONES[entry.tone];
    const el = document.createElement('div');
    el.className = 'tile';
    el.innerHTML =
      '<span class="badge" style="background:' + soft + ';color:' + base + '"><svg class="i"><use href="#i-' + entry.icon + '"/></svg></span>' +
      '<span class="row-main"><b></b><span></span></span>' +
      '<span class="amt ' + (entry.value > 0 ? 'in' : 'out') + '"></span>';
    el.querySelector('.row-main b').textContent = entry.title;
    el.querySelector('.row-main span').textContent = entry.meta;
    el.querySelector('.amt').textContent = (entry.value > 0 ? '+ $ ' : '− $ ') + fmt.format(Math.abs(entry.value));
    return el;
  }

  function visibleCount() {
    const tileH = tiles[0] ? tiles[0].el.offsetHeight : 64;
    return Math.max(2, Math.floor((area.clientHeight - tileH - DECK_MAX * DECK_GAP) / (tileH + 8)) + 1);
  }

  /* Recent tiles show their whole face; older ones compress into a deck at the base. */
  function layout() {
    const tileH = tiles[0] ? tiles[0].el.offsetHeight : 64;
    const step = tileH + 8;
    const visible = visibleCount();
    const pos = new Array(tiles.length);
    pos[tiles.length - 1] = 0;
    for (let i = tiles.length - 2; i >= 0; i--) pos[i] = pos[i + 1] + (i + 1 < visible ? step : DECK_GAP);
    tiles.forEach((t, i) => {
      const deckDepth = Math.max(0, i - visible + 1);
      const scale = 1 - deckDepth * 0.025;
      const tilt = i < visible ? t.tilt : 0;
      t.el.style.zIndex = String(100 - i);
      t.el.style.transform = 'translateY(' + -pos[i] + 'px) rotate(' + tilt + 'deg) scale(' + scale + ')';
      t.el.style.filter = deckDepth ? 'brightness(' + (1 - deckDepth * 0.07) + ')' : '';
    });
  }

  function renderTotals(prev) {
    tweenNumber(balanceEl, prev.income - prev.expense, totals.income - totals.expense, money);
    tweenNumber(incomeEl, prev.income, totals.income, money);
    tweenNumber(expenseEl, prev.expense, totals.expense, money);
  }

  function showDelta(value) {
    deltaEl.textContent = (value > 0 ? '+ $ ' : '− $ ') + fmt.format(Math.abs(value));
    deltaEl.className = 'delta ' + (value > 0 ? 'in' : 'out');
    const lift = reduceMotion.matches ? [] : [{ transform: 'translateY(8px)' }, { transform: 'translateY(-4px)' }, { transform: 'translateY(-10px)' }];
    deltaEl.animate(
      [{ opacity: 0, ...lift[0] }, { opacity: 1, offset: 0.25, ...lift[1] }, { opacity: 0, ...lift[2] }],
      { duration: 1300, easing: 'ease-out' }
    );
  }

  function addEntry(entry, animate) {
    const el = tileMarkup(entry);
    const tilt = TILT[(cursor + monthIndex) % TILT.length];
    tiles.unshift({ el, tilt });
    area.insertBefore(el, deltaEl);
    const prev = { ...totals };
    if (entry.value > 0) totals.income += entry.value; else totals.expense += -entry.value;

    if (animate && !reduceMotion.matches) {
      // Drop from above the pile, then settle into the new layout with everything below shifting.
      el.style.transition = 'none';
      el.style.opacity = '0';
      el.style.transform = 'translateY(-' + (area.clientHeight + 40) + 'px) rotate(-6deg) scale(1.04)';
      el.getBoundingClientRect();
      el.style.transition = '';
      el.style.opacity = '1';
    } else if (animate) {
      el.style.opacity = '0';
      el.getBoundingClientRect();
      el.style.opacity = '1';
    }
    layout();

    // Trim the deck: the oldest tiles sink and leave.
    while (tiles.length > visibleCount() + DECK_MAX) {
      const gone = tiles.pop();
      gone.el.style.opacity = '0';
      setTimeout(() => gone.el.remove(), 500);
    }
    if (animate) { renderTotals(prev); showDelta(entry.value); }
    else { balanceEl.textContent = money(totals.income - totals.expense); incomeEl.textContent = money(totals.income); expenseEl.textContent = money(totals.expense); }
  }

  /* Month closes: the pile clears downward and a new month starts from zero. */
  function closeMonth() {
    const leaving = tiles;
    tiles = [];
    leaving.forEach((t, i) => {
      t.el.style.transitionDelay = (reduceMotion.matches ? 0 : i * 35) + 'ms';
      t.el.style.opacity = '0';
      if (!reduceMotion.matches) t.el.style.transform += ' translateY(40px)';
      setTimeout(() => t.el.remove(), 900);
    });
    const prev = { ...totals };
    totals = { income: 0, expense: 0 };
    renderTotals(prev);
    monthIndex = (monthIndex + 1) % MONTHS.length;
    monthEl.textContent = MONTHS[monthIndex];
    cursor = 0;
  }

  function tick() {
    if (cursor >= MONTH_ENTRIES.length) { closeMonth(); schedule(1400); return; }
    addEntry(MONTH_ENTRIES[cursor], true);
    cursor += 1;
    schedule(cursor >= MONTH_ENTRIES.length ? 2600 : INTERVAL);
  }

  function schedule(delay) {
    clearTimeout(timer);
    timer = null;
    if (userPaused || !onScreen || document.hidden) return;
    timer = setTimeout(tick, delay);
  }

  function resume() { if (!timer) schedule(INTERVAL); }

  for (; cursor < 4; cursor++) addEntry(MONTH_ENTRIES[cursor], false);

  pauseBtn.addEventListener('click', () => {
    userPaused = !userPaused;
    pauseBtn.setAttribute('aria-pressed', String(userPaused));
    document.getElementById('pauseText').textContent = userPaused ? 'Reanudar' : 'Pausar';
    document.getElementById('pauseIcon').setAttribute('href', userPaused ? '#i-play' : '#i-pause');
    if (userPaused) { clearTimeout(timer); timer = null; } else { resume(); }
  });
  document.addEventListener('visibilitychange', () => { if (document.hidden) { clearTimeout(timer); timer = null; } else resume(); });
  new IntersectionObserver((entries) => {
    onScreen = entries[0].isIntersecting;
    if (onScreen) resume(); else { clearTimeout(timer); timer = null; }
  }).observe(area);
  window.addEventListener('resize', () => layout());
  schedule(900);

  /* ---------- Tabs ---------- */
  const tabs = [...document.querySelectorAll('[role="tab"]')];
  function select(tab) {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next); next.focus();
    });
  });

  /* ---------- Hide amounts ---------- */
  const eye = document.getElementById('eye');
  eye.addEventListener('click', () => {
    const hidden = eye.getAttribute('aria-pressed') !== 'true';
    eye.setAttribute('aria-pressed', String(hidden));
    document.getElementById('walletsCard').classList.toggle('hide-amounts', hidden);
    document.getElementById('eyeText').textContent = hidden ? 'Mostrar montos' : 'Ocultar montos';
  });

  /* ---------- Day / night sample ---------- */
  const mini = document.getElementById('miniMonth');
  document.querySelectorAll('[data-theme-pick]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-theme-pick]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    mini.classList.toggle('night', b.dataset.themePick === 'night');
  }));

  /* ---------- Split ---------- */
  const total = 48300;
  const modes = {
    equal: { values: [1, 1, 1], detail: () => 'Un tercio' },
    shares: { values: [2, 1, 1], detail: (v) => v + (v === 1 ? ' parte' : ' partes') },
    percentage: { values: [40, 30, 30], detail: (v) => v + '%' },
    amount: { values: [18300, 15000, 15000], detail: () => 'Importe fijo' },
  };
  const split = (mode) => {
    const { values } = modes[mode];
    if (mode === 'amount') return values.slice();
    const sum = values.reduce((a, b) => a + b, 0);
    return values.map((v) => (total * v) / sum);
  };
  let shares = split('equal');
  const owed = document.getElementById('owed');
  document.getElementById('splitSeg').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-mode]');
    if (!btn) return;
    const mode = btn.dataset.mode;
    document.querySelectorAll('#splitSeg button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    const next = split(mode);
    document.querySelectorAll('#people .detail').forEach((d, i) => { d.textContent = modes[mode].detail(modes[mode].values[i]); });
    document.querySelectorAll('#people [data-share]').forEach((el) => {
      const i = Number(el.dataset.share);
      tweenNumber(el, shares[i], next[i], money, 450);
    });
    tweenNumber(owed, total - shares[0], total - next[0], (v) => 'Te deben ' + money(v), 450);
    shares = next;
  });

  /* ---------- Copy invite code ---------- */
  const copyText = document.getElementById('copyText');
  document.getElementById('copy').addEventListener('click', async () => {
    const code = document.getElementById('code');
    try { await navigator.clipboard.writeText(code.textContent); copyText.textContent = 'Copiado'; }
    catch { const r = document.createRange(); r.selectNodeContents(code); const s = getSelection(); s.removeAllRanges(); s.addRange(r); copyText.textContent = 'Seleccionado'; }
    setTimeout(() => { copyText.textContent = 'Copiar'; }, 1600);
  });

  /* ---------- One reveal per sample, only below the fold ---------- */
  if (!reduceMotion.matches && 'IntersectionObserver' in window) {
    const reveal = {
      bars: (el) => el.querySelectorAll('i').forEach((b, i) => b.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], { duration: 700, delay: i * 60, easing: EASE, fill: 'backwards' })),
      fill: (el) => el.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(' + getComputedStyle(el).getPropertyValue('--to') + ')' }], { duration: 900, delay: 150, easing: EASE, fill: 'backwards' }),
    };
    const seen = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      seen.unobserve(e.target);
      reveal[e.target.dataset.reveal](e.target);
    }), { threshold: 0.4 });
    document.querySelectorAll('[data-reveal]').forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) seen.observe(el); });
  }
})();
</script>

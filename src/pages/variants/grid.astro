  let typing = [];

  /* The keypad types the amount once each time the entry screen is shown. */
  function typeAmount() {
    typing.forEach(clearTimeout);
    typing = [];
    if (reduceMotion) { amount.textContent = '$ 4.500'; return; }
    amount.textContent = '$ 0';
    let typed = '';
    [...'4500'].forEach((d, n) => {
      typing.push(setTimeout(() => {
        typed += d;
        const key = keys[d === '0' ? 10 : Number(d) - 1];
        key.classList.add('tap');
        setTimeout(() => key.classList.remove('tap'), 140);
        amount.textContent = '$ ' + fmt.format(Number(typed));
      }, 520 + n * 260));
    });
  }

  document.getElementById('featureList').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-show]');
    if (!btn) return;
    document.querySelectorAll('#featureList [data-show]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    phone.dataset.show = btn.dataset.show;
    phone.setAttribute('aria-label', LABELS[btn.dataset.show] + ', con datos de ejemplo');
    if (btn.dataset.show === 'entry') typeAmount();
  });

  const copyText = document.getElementById('copyText');
  document.getElementById('copy').addEventListener('click', async () => {
    const code = document.getElementById('code');
    try { await navigator.clipboard.writeText(code.textContent); copyText.textContent = 'Copiado'; }
    catch { const r = document.createRange(); r.selectNodeContents(code); const s = getSelection(); s.removeAllRanges(); s.addRange(r); copyText.textContent = 'Seleccionado'; }
    setTimeout(() => { copyText.textContent = 'Copiar'; }, 1600);
  });
})();
</script>
</Variant>

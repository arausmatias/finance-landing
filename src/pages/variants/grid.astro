<script is:inline>
(() => {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phone = document.getElementById('phone');
  const amount = document.getElementById('amount');
  const keys = [...document.querySelectorAll('#keypad span')];
  const fmt = new Intl.NumberFormat('es-AR');
  const LABELS = {
    chips: 'Pantalla de inicio de Loneto: accesos rápidos con tus categorías',
    entry: 'Pantalla de nuevo movimiento de Loneto con el teclado de la app',
    wallets: 'Pantalla de inicio de Loneto: cuentas en pesos y en dólares',
    habit: 'Pantalla de inicio de Loneto: racha y meta del día',

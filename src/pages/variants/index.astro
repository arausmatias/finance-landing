---
import Variant from '../../layouts/Variant.astro';
import { withBase } from '../../site';

const variants = [
  { href: '', name: 'Actual (Flow)', ref: 'La landing publicada en loneto.app: look de Mix con el recorrido por qué, cómo funciona, lo nuevo, funciones, empezar y comparar, con motion de GSAP', swatch: ['#FFFFFF', '#0E4A34', '#86D6AB'] },
  { href: 'variants/glow/', name: 'Glow', ref: 'Presentación tipo Raycast: escenario oscuro con haces de luz y la app en vivo', swatch: ['#08100D', '#2F9E5B', '#B6EB7D'] },
  { href: 'variants/grid/', name: 'Grid', ref: 'Presentación tipo Vercel: hoja cuadriculada, monocromo, titulares grandes', swatch: ['#050807', '#EDF2EE', '#86D6AB'] },
  { href: 'variants/float/', name: 'Float', ref: 'Presentación tipo Bloome: fondo claro, discos de color y franja verde', swatch: ['#FFFFFF', '#E8893A', '#0E4A34'] },
  { href: 'variants/mix/', name: 'Mix', ref: 'Combinada en modo claro: nav de Float, hero actual, funciones y privacidad de Glow, blog de Float, cierre de Glow', swatch: ['#FFFFFF', '#0E4A34', '#B6EB7D'] },
];
---
<Variant title="Loneto · Variantes de la landing" description="Variantes de la landing de Loneto para comparar." path="variants/" themeColor="#F1F2EE" scheme="light">
<main class="hub">
  <h1>Variantes de la landing</h1>
  <p class="intro">La misma app y el mismo contenido, presentados de cinco formas. Abrí cada una en el teléfono y en la compu.</p>
  <ol class="list">
    {variants.map((v) => (
      <li><a href={withBase(v.href)}>
        <span class="sw" aria-hidden="true">{v.swatch.map((c) => <i style={`background:${c}`}></i>)}</span>
        <span class="txt"><b>{v.name}</b><span>{v.ref}</span></span>
        <svg class="i" aria-hidden="true"><use href="#i-arrow-right"/></svg>
      </a></li>
    ))}
  </ol>
</main>
<style is:global>
*, *::before, *::after { box-sizing: border-box; }
body { margin: 0; background: #F1F2EE; color: #17201B; font-family: "Figtree", system-ui, sans-serif; font-weight: 500; -webkit-font-smoothing: antialiased; }
:focus-visible { outline: 3px solid #0E4A34; outline-offset: 3px; border-radius: 12px; }
.hub { max-width: 720px; margin: 0 auto; padding: 72px 16px; }
h1 { margin: 0; font-size: clamp(32px, 5vw, 44px); font-weight: 800; letter-spacing: -0.03em; }
.intro { margin: 12px 0 32px; color: #66706A; font-size: 17px; }
.list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
.list a { display: grid; grid-template-columns: auto minmax(0, 1fr) 20px; gap: 16px; align-items: center; padding: 18px 20px; border-radius: 24px; background: #FFFFFF; text-decoration: none; color: inherit; box-shadow: 0 1px 3px rgba(16, 32, 24, 0.06); transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1); }
.list a:hover { transform: translateY(-2px); }
.list a:active { transform: scale(0.98); }
.sw { display: flex; }
.sw i { width: 28px; height: 28px; border-radius: 50%; box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 3px #E3E5E0; }
.sw i + i { margin-left: -8px; }
.txt b { display: block; font-size: 19px; font-weight: 800; }
.txt span { color: #66706A; font-size: 15px; }
.i { width: 20px; height: 20px; fill: #0E4A34; }
</style>
</Variant>

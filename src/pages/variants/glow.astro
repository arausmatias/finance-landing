/* ---------- Privacy ---------- */
.privacy { max-width: 1160px; margin: 0 auto; padding: 150px 16px 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
.lock { position: relative; width: 84px; height: 84px; border-radius: 26px; display: grid; place-items: center; background: linear-gradient(180deg, #1F6E4D, #0F3D2B); color: #FFFFFF; box-shadow: 0 0 0 1px rgba(134, 214, 171, 0.35) inset, 0 20px 60px rgba(47, 158, 91, 0.35); margin-bottom: 28px; }

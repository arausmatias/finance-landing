.week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; height: 104px; align-items: end; margin-top: 8px; }
.week i { display: block; height: var(--h); border-radius: 8px; background: #2F5A45; transform-origin: bottom; }

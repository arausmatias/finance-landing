.post:hover { background: rgba(232, 239, 234, 0.04); }
.post .badge { width: 44px; height: 44px; }
.post .badge .i { width: 22px; height: 22px; }
.post-main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.post-main b { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
.post-main span { color: var(--muted); font-size: 15px; max-width: 70ch; }
.post time { color: var(--muted); font-size: 14px; font-weight: 600; white-space: nowrap; }

/* ---------- Close ---------- */
.close { position: relative; max-width: 1160px; margin: 150px auto 0; padding: 96px 16px 104px; text-align: center; display: flex; flex-direction: column; align-items: center; isolation: isolate; overflow: hidden; border-radius: 32px; border: 1px solid var(--line); background: linear-gradient(180deg, #0B1410, #08100D); }
.close-glow { position: absolute; z-index: -1; left: 50%; top: -40%; width: 900px; height: 700px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(47, 158, 91, 0.45), rgba(15, 61, 43, 0.2) 55%, transparent); }
.close-moni { width: 112px; height: 112px; margin-bottom: 24px; filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.5)); }
.close p { margin-top: 14px; color: var(--muted-2); font-size: 18px; }
.stores { margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
.store { height: 58px; padding: 0 20px 0 16px; display: inline-flex; align-items: center; gap: 12px; border-radius: 16px; background: rgba(232, 239, 234, 0.06); border: 1px solid var(--line-2); text-align: left; }
.store .i { width: 26px; height: 26px; }
.store small { display: block; color: var(--muted); font-size: 12px; font-weight: 600; }
.store b { font-size: 17px; font-weight: 700; line-height: 1.1; }

.foot { max-width: 1160px; margin: 0 auto; padding: 48px 16px 56px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: var(--muted); font-size: 14px; }
.foot nav { display: flex; gap: 20px; }
.foot a { text-decoration: none; font-weight: 700; color: var(--muted-2); }
.foot a:hover { color: var(--text); }

/* ---------- Responsive ---------- */
@media (max-width: 1080px) {
  .stage { grid-template-columns: minmax(0, 1fr) auto; padding: 48px 40px; gap: 36px 40px; }
  .side { grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .facts { flex-direction: row; flex-wrap: wrap; gap: 14px 28px; }
  .facts li { max-width: 260px; }
  .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  .hero { padding: 132px 16px 72px; min-height: 0; }
  .statement { padding: 24px 16px 40px; }
  .stage { grid-template-columns: minmax(0, 1fr); padding: 28px 16px 32px; border-radius: 28px; justify-items: center; }
  .steps { width: 100%; order: 2; }
  .phone-col { order: 1; }
  .side { order: 3; flex-direction: column; align-items: flex-start; width: 100%; }
  .facts { flex-direction: column; }
  .step { padding: 12px 12px 16px; }
  .features, .privacy, .blog { padding-top: 104px; }
  .cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-inline: -16px; padding: 0 16px 8px; scrollbar-width: none; }
  .cards::-webkit-scrollbar { display: none; }
  .card { flex: 0 0 min(86vw, 360px); scroll-snap-align: center; padding: 22px; }
  .promises { grid-template-columns: minmax(0, 1fr); }
  .promises li { padding: 22px 4px 0; }
  .promises li + li { border-left: 0; border-top: 1px solid var(--line); margin-top: 22px; }
  .post { grid-template-columns: 44px minmax(0, 1fr); }
  .post time { grid-column: 2; }
  .close { margin-top: 104px; padding: 72px 16px 80px; border-radius: 28px; }
}
@media (max-width: 380px) { .phone { transform: scale(0.9); margin: -34px 0; } }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .beam, .caret, .cards:not([hidden]) { animation: none; }
  .entry, .chip, .keypad span, .track .fill, .wallet { transition: none; }
  .row.new, .stat-pill.lit .i { animation: none; }
}
</style>

<script is:inline>
(() => {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
  const money = (v) => '$ ' + fmt.format(Math.round(v));
  const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';

  const tweens = new WeakMap();
  function tween(el, from, to, format, duration = 600) {
    cancelAnimationFrame(tweens.get(el));
    if (reduceMotion || from === to) { el.textContent = format(to); return; }
    const start = performance.now();
    const step = (now) => {
      const t = Math.min(1, (now - start) / duration);
      el.textContent = format(from + (to - from) * (1 - Math.pow(1 - t, 4)));
      if (t < 1) tweens.set(el, requestAnimationFrame(step));
    };
    tweens.set(el, requestAnimationFrame(step));
  }

  /* ---------- Stage: the quick-add flow, played on a loop ---------- */
  const TONES = { yellow: ['--yellow-soft', '--yellow'], blue: ['--blue-soft', '--blue'], green: ['--green-soft', '--green'], red: ['--red-soft', '--red'] };
  const FLOW = [
    { chip: 'coffee', title: 'Café', meta: 'Efectivo', account: 'Efectivo', tone: 'yellow', digits: '4500' },
    { chip: 'bus', title: 'Colectivo', meta: 'Débito', account: 'Banco', tone: 'blue', digits: '1070' },
    { chip: 'cart', title: 'Súper', meta: 'Débito', account: 'Banco', tone: 'green', digits: '23180' },
    { chip: 'gas-station', title: 'Nafta', meta: 'Crédito', account: 'Banco', tone: 'red', digits: '42000' },
  ];
  const GOAL = 3;
  const BASE_EXPENSE = 380000;
  const stage = document.querySelector('.stage');
  const entryEl = document.getElementById('entry');
  const amountEl = document.getElementById('amount');
  const rowsEl = document.getElementById('rows');
  const streakEl = document.getElementById('streak');
  const streakNum = document.getElementById('streakNum');
  const goalText = document.getElementById('goalText');
  const goalFill = document.getElementById('goalFill');
  const monthExp = document.getElementById('monthExp');
  const saveEl = document.getElementById('save');
  const steps = [...document.querySelectorAll('.step')];
  const keys = [...document.querySelectorAll('#keypad span')];
  const initialRows = rowsEl.innerHTML;
  const pauseBtn = document.getElementById('pause');

  let paused = reduceMotion;
  let onScreen = false;
  let timer = null;
  let pending = null;
  let queue = [];
  let state;

  function reset() {
    state = { index: 0, logged: 0, expense: BASE_EXPENSE };
    rowsEl.innerHTML = initialRows;
    streakEl.classList.remove('lit');
    streakNum.textContent = '12';
    goalText.textContent = '0 de ' + GOAL + ' movimientos';
    goalText.classList.remove('done');
    goalFill.style.setProperty('--to', '0');
    monthExp.textContent = money(BASE_EXPENSE);
  }

  function setStep(i, duration) {
    steps.forEach((s, n) => {
      s.classList.toggle('on', n === i);
      s.style.setProperty('--d', duration + 'ms');
    });
  }

  function tap(el, ms = 180) { el.classList.add('tap'); setTimeout(() => el.classList.remove('tap'), ms); }

  function rowMarkup(e) {
    const [soft, base] = TONES[e.tone];
    const li = document.createElement('li');
    li.className = 'row new';
    li.innerHTML = '<span class="badge" style="background:var(' + soft + ');color:var(' + base + ')"><svg class="i"><use href="#i-' + e.chip + '"/></svg></span><span class="row-main"><b></b><span></span></span><span class="amt out"></span>';
    li.querySelector('b').textContent = e.title;
    li.querySelector('.row-main span').textContent = e.meta;
    li.querySelector('.amt').textContent = '− $ ' + fmt.format(Number(e.digits));
    return li;
  }

  /* Build one entry as a list of [delay, action] beats. */
  function beats(e) {
    const out = [];
    const typeTime = e.digits.length * 260;
    out.push([0, () => { setStep(0, 1400); amountEl.textContent = '$ 0'; }]);
    out.push([500, () => tap(document.querySelector('#chips [data-chip="' + e.chip + '"]'), 260)]);
    out.push([380, () => {
      document.querySelectorAll('#entryChips .chip').forEach((c) => c.classList.toggle('sel', c.dataset.chip === e.chip));
      document.querySelector('#entryAccount span').textContent = e.account;
      entryEl.classList.add('open');
    }]);
    out.push([520, () => setStep(1, typeTime + 460)]);
    let typed = '';
    [...e.digits].forEach((d, n) => {
      out.push([n === 0 ? 300 : 260, () => {
        typed += d;
        tap(keys[d === '0' ? 10 : Number(d) - 1], 140);
        amountEl.textContent = money(Number(typed));
      }]);
    });
    out.push([420, () => { setStep(2, 2180); tap(saveEl, 220); }]);
    out.push([280, () => {
      entryEl.classList.remove('open');
      const value = Number(e.digits);
      rowsEl.prepend(rowMarkup(e));
      while (rowsEl.children.length > 4) rowsEl.lastElementChild.remove();
      tween(monthExp, state.expense, state.expense + value, money);
      state.expense += value;
      state.logged += 1;
      if (state.logged === 1) { streakEl.classList.add('lit'); streakNum.textContent = '13'; }
      const done = Math.min(state.logged, GOAL);
      goalFill.style.setProperty('--to', String(done / GOAL));
      goalText.textContent = state.logged >= GOAL ? '¡Meta cumplida!' : done + ' de ' + GOAL + ' movimientos';
      goalText.classList.toggle('done', state.logged >= GOAL);
    }]);
    out.push([1900, () => {}]);
    return out;
  }

  function nextEntry() {
    if (state.index >= FLOW.length) { queue = [[600, reset], [400, () => {}]]; state.index = 0; return; }
    queue = beats(FLOW[state.index]);
    state.index += 1;
  }

  /* A stopped beat goes back to the front of the queue, so pausing never skips a step. */
  function stop() {
    if (!timer) return;
    clearTimeout(timer);
    timer = null;
    queue.unshift(pending);
    pending = null;
  }

  function run() {
    if (timer || paused || !onScreen || document.hidden) return;
    if (!queue.length) nextEntry();
    pending = queue.shift();
    timer = setTimeout(() => {
      const [, action] = pending;
      pending = null;
      timer = null;
      action();
      run();
    }, pending[0]);
  }

  function setPaused(value) {
    paused = value;
    stage.classList.toggle('paused', paused);
    pauseBtn.setAttribute('aria-pressed', String(paused));
    document.getElementById('pauseText').textContent = paused ? 'Reproducir' : 'Pausar';
    document.getElementById('pauseIcon').setAttribute('href', paused ? '#i-play' : '#i-pause');
    if (paused) stop(); else run();
  }

  reset();
  if (reduceMotion) {
    // Settled frame: the first entry already logged, nothing moving.
    rowsEl.prepend(rowMarkup(FLOW[0]));
    streakEl.classList.add('lit'); streakNum.textContent = '13';
    goalFill.style.setProperty('--to', String(1 / GOAL));
    goalText.textContent = '1 de ' + GOAL + ' movimientos';
    monthExp.textContent = money(BASE_EXPENSE + 4500);
    state.index = 1; state.logged = 1; state.expense = BASE_EXPENSE + 4500;
    setStep(2, 0);
  }
  setPaused(paused);
  pauseBtn.addEventListener('click', () => setPaused(!paused));
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : run()));
  new IntersectionObserver((entries) => {
    onScreen = entries[0].isIntersecting;
    if (onScreen) run(); else stop();
  }, { threshold: 0.25 }).observe(stage);

  /* ---------- Tabs ---------- */
  const tabs = [...document.querySelectorAll('[role="tab"]')];
  function select(tab) {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next); next.focus();
    });
  });

  /* ---------- Hide amounts ---------- */
  const eye = document.getElementById('eye');
  eye.addEventListener('click', () => {
    const hidden = eye.getAttribute('aria-pressed') !== 'true';
    eye.setAttribute('aria-pressed', String(hidden));
    document.getElementById('walletsCard').classList.toggle('hide-amounts', hidden);
    document.getElementById('eyeText').textContent = hidden ? 'Mostrar montos' : 'Ocultar montos';
  });

  /* ---------- Day / night sample ---------- */
  const mini = document.getElementById('miniMonth');
  document.querySelectorAll('[data-theme-pick]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-theme-pick]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    mini.classList.toggle('day', b.dataset.themePick === 'day');
  }));

  /* ---------- Split ---------- */
  const total = 48300;
  const modes = {
    equal: { values: [1, 1, 1], detail: () => 'Un tercio' },
    shares: { values: [2, 1, 1], detail: (v) => v + (v === 1 ? ' parte' : ' partes') },
    percentage: { values: [40, 30, 30], detail: (v) => v + '%' },
    amount: { values: [18300, 15000, 15000], detail: () => 'Importe fijo' },
  };
  const split = (mode) => {
    const { values } = modes[mode];
    if (mode === 'amount') return values.slice();
    const sum = values.reduce((a, b) => a + b, 0);
    return values.map((v) => (total * v) / sum);
  };
  let shares = split('equal');
  const owed = document.getElementById('owed');
  document.getElementById('splitSeg').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-mode]');
    if (!btn) return;
    const mode = btn.dataset.mode;
    document.querySelectorAll('#splitSeg button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    const next = split(mode);
    document.querySelectorAll('#people .detail').forEach((d, i) => { d.textContent = modes[mode].detail(modes[mode].values[i]); });
    document.querySelectorAll('#people [data-share]').forEach((el) => {
      const i = Number(el.dataset.share);
      tween(el, shares[i], next[i], money, 450);
    });
    tween(owed, total - shares[0], total - next[0], (v) => 'Te deben ' + money(v), 450);
    shares = next;
  });

  /* ---------- Copy invite code ---------- */
  const copyText = document.getElementById('copyText');
  document.getElementById('copy').addEventListener('click', async () => {
    const code = document.getElementById('code');
    try { await navigator.clipboard.writeText(code.textContent); copyText.textContent = 'Copiado'; }
    catch { const r = document.createRange(); r.selectNodeContents(code); const s = getSelection(); s.removeAllRanges(); s.addRange(r); copyText.textContent = 'Seleccionado'; }
    setTimeout(() => { copyText.textContent = 'Copiar'; }, 1600);
  });

  /* ---------- One reveal per sample, only below the fold ---------- */
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const reveal = {
      bars: (el) => el.querySelectorAll('i').forEach((b, i) => b.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], { duration: 700, delay: i * 60, easing: EASE, fill: 'backwards' })),
      fill: (el) => el.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(' + getComputedStyle(el).getPropertyValue('--to') + ')' }], { duration: 900, delay: 150, easing: EASE, fill: 'backwards' }),
    };
    const seen = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      seen.unobserve(e.target);
      reveal[e.target.dataset.reveal](e.target);
    }), { threshold: 0.4 });
    document.querySelectorAll('[data-reveal]').forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) seen.observe(el); });
  }
})();
</script>

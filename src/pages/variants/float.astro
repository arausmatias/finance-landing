---
import { getCollection } from 'astro:content';
import Variant from '../../layouts/Variant.astro';
import { sortPosts, formatDate, withBase } from '../../site';

const posts = sortPosts(await getCollection('blog'));

/** Floating discs around the hero headline: a glyph on a category tone, or Moni herself. */
const discs = [
  { side: 'l', x: 17, y: 20, size: 150, depth: 0.6, tone: '#E8893A', icon: 'coffee' },
  { side: 'l', x: 6, y: 50, size: 210, depth: 1, moni: 'happy', tone: '#FCE8D6' },
  { side: 'l', x: 15, y: 78, size: 160, depth: 0.8, tone: '#8B5CD6', icon: 'account-group' },
  { side: 'r', x: 16, y: 22, size: 140, depth: 0.7, tone: '#DCEAF7', icon: 'bus', ink: '#1F5F9A' },
  { side: 'r', x: 5, y: 52, size: 210, depth: 1, tone: '#2F7FC8', icon: 'wallet' },
  { side: 'r', x: 15, y: 80, size: 150, depth: 0.6, moni: 'sleepy', tone: '#DDF3E4' },
];
---
<Variant
  title="Loneto · Variante Float"
  description="Variante de la landing de Loneto: los colores de la app flotan fuera de la pantalla."
  path="variants/float/"
  themeColor="#FFFFFF"
  scheme="light"
>
<span class="nav-sentinel" aria-hidden="true"></span>
<header class="nav-wrap" id="navWrap">
  <nav class="nav" aria-label="Principal">
    <a class="logo" href="#top"><svg viewBox="0 0 120 120" aria-hidden="true"><use href="#moni-happy"/></svg>Loneto</a>
    <span class="nav-links">
      <a href="#como">Cómo funciona</a>
      <a href="#compartido">Compartido</a>
      <a href="#privacidad">Privacidad</a>
      <a href={withBase('blog/')}>Blog</a>
    </span>
    <a class="nav-cta press" href="#bajar">Cuándo sale</a>
  </nav>
</header>

<main id="top">
  <section class="hero" aria-labelledby="h-hero">
    <div class="discs" aria-hidden="true">
      {discs.map((d) => (
        <span class={`disc disc-${d.side}`} data-depth={d.depth}
          style={`--x:${d.x}%;--y:${d.y}%;--s:${d.size}px;--tone:${d.tone};--ink:${d.ink ?? '#17201B'}`}>
          <span class="disc-in">
            {d.moni
              ? <svg class="disc-moni" viewBox="0 0 120 120"><use href={`#moni-${d.moni}`} /></svg>
              : <svg class="i"><use href={`#i-${d.icon}`} /></svg>}
          </span>
        </span>
      ))}
    </div>
    <div class="hero-copy">
      <h1 id="h-hero"><span class="light">Tu plata,</span> <span class="light">anotada</span> <span class="heavy">en segundos.</span></h1>
      <p class="lead">Cada ingreso y cada gasto en tres toques, en pesos o en dólares. Dividí cuentas con quien quieras, y que todo quede en tu teléfono.</p>
      <a class="btn-forest press" href="#como">Mirá cómo funciona</a>
      <p class="soon">Muy pronto en</p>
      <ul class="platforms">
        <li><svg class="i" aria-hidden="true"><use href="#i-apple"/></svg>iPhone</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-google-play"/></svg>Android</li>
      </ul>
    </div>
  </section>

  <section class="window-wrap" aria-label="La app">
    <div class="window">
      <div class="phones" aria-hidden="true">
        <div class="phone p-left">
          <div class="scr">
            <div class="st"><span>9:41</span><i class="bat"></i></div>
            <div class="hd"><b>Hola, Vale</b><span class="spill"><svg class="i"><use href="#i-fire"/></svg>13</span></div>
            <div class="wal"><div style="background:#1F5F9A"><span>ARS · Banco</span><b>$ 412.650</b></div><div style="background:#147369"><span>USD · Ahorro</span><b>US$ 1.250</b></div></div>
            <span class="lb">Cargar rápido</span>
            <div class="ch"><span><svg class="i" style="color:#E0B021"><use href="#i-coffee"/></svg>Café</span><span><svg class="i" style="color:#2F9E5B"><use href="#i-cart"/></svg>Súper</span><span><svg class="i" style="color:#2F7FC8"><use href="#i-bus"/></svg>Colectivo</span></div>
            <span class="lb">Últimos movimientos</span>
            <ul class="rw">
              <li><span class="bd" style="background:#FBF1D0;color:#E0B021"><svg class="i"><use href="#i-coffee"/></svg></span><span><b>Café</b><small>Efectivo</small></span><b class="o">− $ 4.500</b></li>
              <li><span class="bd" style="background:#DCEAF7;color:#2F7FC8"><svg class="i"><use href="#i-bus"/></svg></span><span><b>Colectivo</b><small>Débito</small></span><b class="o">− $ 1.070</b></li>
              <li><span class="bd" style="background:#DDF3E4;color:#2F9E5B"><svg class="i"><use href="#i-briefcase"/></svg></span><span><b>Sueldo</b><small>Banco</small></span><b class="n">+ $ 1.250.000</b></li>
            </ul>
          </div>
        </div>
        <div class="phone p-mid">
          <div class="scr">
            <div class="st"><span>9:41</span><i class="bat"></i></div>
            <div class="hd hd-c"><svg class="i"><use href="#i-chevron-left"/></svg><b>Casa compartida</b><span></span></div>
            <div class="grp-hero"><span>Te deben</span><b>$ 15.000</b><small>3 personas · Compartido</small></div>
            <span class="lb">Cómo saldar</span>
            <ul class="settle"><li><span class="av" style="background:#FCE8D6;color:#9E561A">S</span>Sofi<svg class="i"><use href="#i-arrow-right"/></svg><span class="av" style="background:#DCEBE3;color:#0E4A34">V</span>Vos<b>$ 10.200</b></li><li><span class="av" style="background:#DCEAF7;color:#1F5F9A">T</span>Tomi<svg class="i"><use href="#i-arrow-right"/></svg><span class="av" style="background:#DCEBE3;color:#0E4A34">V</span>Vos<b>$ 4.800</b></li></ul>
            <span class="lb">Gastos</span>
            <ul class="rw">
              <li><span class="bd" style="background:#FCE8D6;color:#E8893A"><svg class="i"><use href="#i-silverware-fork-knife"/></svg></span><span><b>Cena</b><small>Pagaste vos</small></span><b>$ 48.300</b></li>
              <li><span class="bd" style="background:#DDF3E4;color:#2F9E5B"><svg class="i"><use href="#i-cart"/></svg></span><span><b>Súper</b><small>Pagó Sofi</small></span><b>$ 23.100</b></li>
              <li><span class="bd" style="background:#FBF1D0;color:#E0B021"><svg class="i"><use href="#i-lightning-bolt"/></svg></span><span><b>Luz</b><small>Pagó Tomi</small></span><b>$ 28.500</b></li>
            </ul>
          </div>
        </div>
        <div class="phone p-right">
          <div class="scr">
            <div class="st"><span>9:41</span><i class="bat"></i></div>
            <div class="hd hd-c"><svg class="i"><use href="#i-chevron-left"/></svg><b>Nuevo movimiento</b><span></span></div>
            <div class="sg"><span class="on">Gasto</span><span>Ingreso</span><span>Transferencia</span></div>
            <div class="am"><small>ARS</small><b>$ 4.500</b></div>
            <div class="ch"><span class="sel"><svg class="i"><use href="#i-coffee"/></svg>Café</span><span>Súper</span><span>Colectivo</span></div>
            <div class="kp"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>,</span><span>0</span><span><svg class="i"><use href="#i-backspace-outline"/></svg></span></div>
            <span class="sv">Guardar</span>
          </div>
        </div>
      </div>
    </div>
    <p class="window-cap">Inicio, un grupo compartido y el teclado de la app, con datos de ejemplo.</p>
  </section>

  <section class="rows" id="como" aria-labelledby="h-why">
    <h2 class="mixed" id="h-why"><span class="light">Hecha para anotar</span> <span class="heavy">todos los días.</span></h2>

    <article class="feature">
      <div class="feature-copy">
        <h3>Anotás en segundos.</h3>
        <p>Tocás un acceso rápido, marcás el monto con el teclado de la app y listo. El primer movimiento del día prende tu racha.</p>
      </div>
      <div class="panel" data-pop>
        <span class="panel-title">Hoy</span>
        <div class="bubble b-yellow pop" style="--r:-2deg"><span class="bd"><svg class="i" aria-hidden="true"><use href="#i-coffee"/></svg></span><span><b>Café</b><small>Efectivo</small></span><b class="o">− $ 4.500</b></div>
        <div class="bubble b-blue pop shift-r" style="--r:1.5deg"><span class="bd"><svg class="i" aria-hidden="true"><use href="#i-bus"/></svg></span><span><b>Colectivo</b><small>Débito</small></span><b class="o">− $ 1.070</b></div>
        <div class="bubble b-green pop shift-l" style="--r:-1deg"><span class="bd"><svg class="i" aria-hidden="true"><use href="#i-cart"/></svg></span><span><b>Súper</b><small>Débito</small></span><b class="o">− $ 23.180</b></div>
        <div class="bubble b-forest pop out-r" style="--r:2deg"><svg class="i" aria-hidden="true"><use href="#i-fire"/></svg><span><b>Racha de 13 días</b><small>¡Meta de hoy cumplida!</small></span></div>
      </div>
    </article>

    <article class="feature flip">
      <div class="feature-copy">
        <h3>Dividí sin hacer cuentas.</h3>
        <p>Iguales, por partes, por porcentaje o por importe. Los demás no necesitan tener la app: la llevás vos y marcás quién te pagó.</p>
        <div class="modes" role="group" aria-label="Forma de dividir" id="splitSeg">
          <button class="press" type="button" data-mode="equal" aria-pressed="true">Iguales</button>
          <button class="press" type="button" data-mode="shares" aria-pressed="false">Partes</button>
          <button class="press" type="button" data-mode="percentage" aria-pressed="false">%</button>
          <button class="press" type="button" data-mode="amount" aria-pressed="false">Importe</button>
        </div>
      </div>
      <div class="panel" data-pop>
        <div class="bubble b-white pop wide"><span class="bd" style="background:#FCE8D6;color:#E8893A"><svg class="i" aria-hidden="true"><use href="#i-silverware-fork-knife"/></svg></span><span><b>Cena en lo de Sofi</b><small>Pagaste vos · 3 personas</small></span><b class="num">$ 48.300</b></div>
        <div class="share-row">
          <div class="bubble b-green pop share" style="--r:-3deg"><span class="av">V</span><span><b>Vos</b><small class="detail">Un tercio</small></span><b class="num" data-share="0">$ 16.100</b></div>
          <div class="bubble b-orange pop share" style="--r:2deg"><span class="av">S</span><span><b>Sofi</b><small class="detail">Un tercio</small></span><b class="num" data-share="1">$ 16.100</b></div>
          <div class="bubble b-blue pop share" style="--r:-1deg"><span class="av">T</span><span><b>Tomi</b><small class="detail">Un tercio</small></span><b class="num" data-share="2">$ 16.100</b></div>
        </div>
        <div class="bubble b-forest pop out-l"><svg class="i" aria-hidden="true"><use href="#i-check-circle"/></svg><b class="num" id="owed">Te deben $ 32.200</b></div>
      </div>
    </article>

    <article class="feature">
      <div class="feature-copy">
        <h3>Pesos y dólares, cada uno en su cuenta.</h3>
        <p>Efectivo, banco, tarjeta y billetera virtual, cada una con su moneda. Las monedas nunca se mezclan, y podés ocultar los montos cuando hay gente mirando.</p>
        <button class="eye press" id="eye" type="button" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#i-eye-outline"/></svg><span id="eyeText">Ocultar montos</span></button>
      </div>
      <div class="panel wallets-panel" data-pop id="walletsPanel">
        <div class="wallet pop" style="background:#1F5F9A;--r:-6deg"><span class="w-ico"><svg class="i" aria-hidden="true"><use href="#i-bank"/></svg></span><span class="w-name">ARS · Banco</span><b class="w-bal"><span>$ 412.650</span><i>••••••</i></b></div>
        <div class="wallet pop" style="background:#1F7A44;--r:4deg"><span class="w-ico"><svg class="i" aria-hidden="true"><use href="#i-wallet"/></svg></span><span class="w-name">ARS · Efectivo</span><b class="w-bal"><span>$ 38.200</span><i>••••••</i></b></div>
        <div class="wallet pop" style="background:#6B42B0;--r:-2deg"><span class="w-ico"><svg class="i" aria-hidden="true"><use href="#i-credit-card"/></svg></span><span class="w-name">ARS · Tarjeta de crédito</span><b class="w-bal"><span>−$ 112.400</span><i>••••••</i></b></div>
        <div class="wallet pop" style="background:#147369;--r:5deg"><span class="w-ico"><svg class="i" aria-hidden="true"><use href="#i-cash"/></svg></span><span class="w-name">USD · Ahorro</span><b class="w-bal"><span>US$ 1.250</span><i>••••••</i></b></div>
      </div>
    </article>
  </section>

  <section class="slab-wrap" id="compartido" aria-labelledby="h-rec">
    <div class="slab">
      <svg class="swoosh" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true"><path d="M-80 520 C 220 380, 380 640, 640 430 S 980 120, 1300 210" fill="none" stroke="#86D6AB" stroke-width="64" stroke-linecap="round" opacity="0.9"/></svg>
      <h2 id="h-rec">Lo que pagan todos los meses, <span>compartido.</span></h2>
      <p>Cargalo una vez y cada uno sabe cuánto le toca y cuándo. Cada persona anota solo su parte.</p>
      <ul class="rec-pills" aria-label="Ejemplos">
        <li><svg class="i" aria-hidden="true"><use href="#i-play-box-multiple"/></svg>Streaming</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-home"/></svg>Alquiler</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-home-variant"/></svg>Expensas</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-lightning-bolt"/></svg>Luz</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-wifi"/></svg>Internet</li>
        <li><svg class="i" aria-hidden="true"><use href="#i-music"/></svg>Música</li>
      </ul>
      <div class="rec-card">
        <div class="rec-head"><span class="bd" style="background:#DCEAF7;color:#2F7FC8"><svg class="i" aria-hidden="true"><use href="#i-play-box-multiple"/></svg></span><span><b>Streaming en familia</b><small>Vence el día 10 de cada mes · 4 personas</small></span><b class="num">$ 9.600</b></div>
        <ul class="statuses">
          <li><span class="av" style="background:#DCEBE3;color:#0E4A34">V</span><b>Vos</b><span class="tag" style="background:#DCEBE3;color:#0E4A34">Paga la cuenta</span></li>
          <li><span class="av" style="background:#F9DFE8;color:#B03B61">M</span><b>Mamá</b><span class="tag" style="background:#DDF3E4;color:#1F7A44">Pagado</span></li>
          <li><span class="av" style="background:#EBE2FA;color:#6B42B0">J</span><b>Juli</b><span class="tag" style="background:#FBF1D0;color:#85680A">Informó que pagó</span></li>
          <li><span class="av" style="background:#E8EAE4;color:#4F5953">N</span><b>Nico</b><span class="tag" style="background:#E8EAE4;color:#4F5953">Pendiente</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cards-sec" aria-labelledby="h-all">
    <h2 class="mixed" id="h-all"><span class="heavy">Todo lo tuyo</span> <span class="light">en un solo lugar.</span></h2>
    <div class="tcards">
      <article class="tcard" style="--bg:#DCEAF7;--ink:#1F5F9A">
        <h3>Racha y niveles</h3>
        <p>Una racha, una meta diaria y niveles para que anotar se vuelva costumbre. Nadie te reta por lo que gastás.</p>
        <div class="tvis habit">
          <svg class="moni" viewBox="0 0 120 120" aria-hidden="true"><use href="#moni-happy"/></svg>
          <div class="habit-ui">
            <div class="pills"><span class="pill"><svg class="i" style="color:#E8893A" aria-hidden="true"><use href="#i-fire"/></svg>Racha de 12 días</span><span class="pill"><svg class="i" style="color:#E0B021" aria-hidden="true"><use href="#i-star-four-points"/></svg>Nivel 4</span></div>
            <div class="week" aria-hidden="true"><i style="--h:46%"></i><i style="--h:72%"></i><i style="--h:30%"></i><i style="--h:58%"></i><i class="today" style="--h:84%"></i><i class="fut" style="--h:10%"></i><i class="fut" style="--h:10%"></i></div>
          </div>
        </div>
      </article>
      <article class="tcard" style="--bg:#DDF3E4;--ink:#1F7A44">
        <h3>Grupos con código</h3>
        <p>Compartí un grupo con un código de 6 caracteres. Cada uno carga lo suyo y todo cambio queda en la actividad.</p>
        <div class="tvis group">
          <div class="invite"><div><span class="label">Código de invitación</span><b class="code" id="code">X7K2QP</b><span class="valid">Vale 7 días</span></div><button class="copy press" id="copy" type="button"><svg class="i" aria-hidden="true"><use href="#i-content-copy"/></svg><span id="copyText">Copiar</span></button></div>
          <ul class="activity"><li><span class="av" style="background:#FCE8D6;color:#9E561A">S</span>Sofi editó “Cena en lo de Sofi”</li><li><span class="av" style="background:#DCEAF7;color:#1F5F9A">T</span>Tomi borró “Nafta”</li></ul>
        </div>
      </article>
      <article class="tcard" style="--bg:#FCE8D6;--ink:#9E561A">
        <h3>De día o de noche</h3>
        <p>Tema claro y oscuro, cada uno pensado aparte. En español o en inglés.</p>
        <div class="tvis themes">
          <div class="mm mm-day"><span>Balance del mes</span><b class="in">$ 1.250.000</b><b class="out">$ 812.300</b><div class="mm-bar"><i style="width:32%;background:#2F9E5B"></i><i style="width:21%;background:#E8893A"></i><i style="width:14%;background:#2F7FC8"></i><i style="width:33%;background:#1FA396"></i></div></div>
          <div class="mm mm-night"><span>Balance del mes</span><b class="in">$ 1.250.000</b><b class="out">$ 812.300</b><div class="mm-bar"><i style="width:32%;background:#44B872"></i><i style="width:21%;background:#EE9A52"></i><i style="width:14%;background:#4C95DE"></i><i style="width:33%;background:#2DBAAB"></i></div></div>
        </div>
      </article>
      <article class="tcard" id="privacidad" style="--bg:#EBE2FA;--ink:#6B42B0">
        <h3>Tus datos quedan en tu teléfono</h3>
        <p>Para usarla no hace falta crear una cuenta ni conectar el banco. Solo sale del teléfono lo que decidís compartir.</p>
        <div class="tvis privacy">
          <span class="lock"><svg class="i" aria-hidden="true"><use href="#i-cellphone-lock"/></svg></span>
          <ul class="checks">
            <li><svg class="i" aria-hidden="true"><use href="#i-check-bold"/></svg>Sin crear cuenta</li>
            <li><svg class="i" aria-hidden="true"><use href="#i-check-bold"/></svg>Sin conectar el banco</li>
            <li><svg class="i" aria-hidden="true"><use href="#i-check-bold"/></svg>Compartís solo lo que elegís</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <section class="blog" aria-labelledby="h-blog">
    <div class="blog-head"><h2 id="h-blog">Del blog</h2><a href={withBase('blog/')}>Ver todos <svg class="i" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></div>
    <ul class="posts">
      {posts.map((post) => (
        <li><a class="post" href={withBase(`blog/${post.id}/`)}>
          <span class="post-disc" style={`background:var(--${post.data.tone})`}><svg class="i" aria-hidden="true"><use href={`#i-${post.data.icon}`} /></svg></span>
          <span class="post-main"><b>{post.data.title}</b><span>{post.data.description}</span></span>
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
        </a></li>
      ))}
    </ul>
  </section>

  <section class="close" id="bajar" aria-labelledby="h-close">
    <span class="cdisc c1" aria-hidden="true"><svg viewBox="0 0 120 120"><use href="#moni-wow"/></svg></span>
    <span class="cdisc c2" aria-hidden="true" style="--tone:#D6517A"><svg class="i"><use href="#i-gift"/></svg></span>
    <span class="cdisc c3" aria-hidden="true" style="--tone:#1FA396"><svg class="i"><use href="#i-calendar-refresh"/></svg></span>
    <h2 class="mixed" id="h-close"><span class="light">Anotá hoy.</span> <span class="heavy">Mañana ya es costumbre.</span></h2>
    <p>Loneto llega pronto a iPhone y Android, en español y en inglés.</p>
    <div class="stores">
      <span class="store"><svg class="i" aria-hidden="true"><use href="#i-apple"/></svg><span><small>Próximamente</small><b>App Store</b></span></span>
      <span class="store"><svg class="i" aria-hidden="true"><use href="#i-google-play"/></svg><span><small>Próximamente</small><b>Google Play</b></span></span>
    </div>
  </section>
</main>

<footer class="foot">
  <nav aria-label="Pie de página"><a href={withBase('')}>Loneto</a><a href={withBase('blog/')}>Blog</a><a href={withBase('variants/')}>Variantes</a></nav>
  <p>Los montos, nombres y cuentas de esta página son de ejemplo.</p>
</footer>

<style is:global>
:root {
  --page: #FFFFFF; --panel: #F1F2EE; --panel-2: #E8EAE4; --line: #E3E5E0; --line-2: #C9CDC6;
  --text: #17201B; --muted: #66706A; --muted-2: #4F5953;
  --forest: #0E4A34; --forest-deep: #093324; --mint: #86D6AB; --on-forest-muted: #B5D3C4;
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --font: "Figtree", ui-rounded, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --green: #2F9E5B; --blue: #2F7FC8; --red: #E05A4F; --orange: #E8893A; --yellow: #E0B021; --purple: #8B5CD6; --pink: #D6517A; --teal: #1FA396;
}
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scrollbar-color: var(--line-2) var(--page); }
body { margin: 0; background: var(--page); color: var(--text); font-family: var(--font); font-weight: 500; font-size: 17px; line-height: 1.55; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
::selection { background: #B6EB7D; color: var(--forest); }
:focus-visible { outline: 3px solid var(--forest); outline-offset: 3px; border-radius: 12px; }
h1, h2, h3, p, ul, ol { margin: 0; }
ul, ol { padding: 0; list-style: none; }
a { color: inherit; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
.i { width: 20px; height: 20px; fill: currentColor; flex: none; }
.num { font-variant-numeric: tabular-nums; }
.press { transition: transform 160ms var(--ease), opacity 160ms var(--ease), background-color 160ms, color 160ms, border-color 160ms, box-shadow 160ms; }
.press:active { transform: scale(0.97); opacity: 0.9; }
main { overflow-x: clip; }

/* ---------- Mixed-weight headings ---------- */
.light { font-weight: 500; letter-spacing: -0.035em; }
.heavy { font-weight: 800; letter-spacing: -0.04em; }
.mixed { text-align: center; font-size: clamp(36px, 5.4vw, 72px); line-height: 1.02; text-wrap: balance; }
.mixed span { display: block; }

/* ---------- Nav: becomes a floating pill once you scroll ---------- */
.nav-sentinel { position: absolute; top: 0; height: 24px; width: 1px; }
.nav-wrap { position: sticky; top: 0; z-index: 50; padding: 0 16px; }
.nav { max-width: 1160px; margin: 0 auto; height: 68px; padding: 0 12px 0 20px; display: flex; align-items: center; gap: 24px; border-radius: 999px; border: 1px solid transparent; transition: transform 300ms var(--ease), background-color 300ms, box-shadow 300ms, border-color 300ms; }
.floating .nav { transform: translateY(12px); background: rgba(255, 255, 255, 0.86); border-color: var(--line); box-shadow: 0 10px 30px rgba(16, 32, 24, 0.1); backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3); }
.logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 21px; letter-spacing: -0.02em; text-decoration: none; }
.logo svg { width: 32px; height: 32px; }
.nav-links { display: flex; gap: 32px; margin-inline: auto; font-size: 16px; font-weight: 600; }
.nav-links a { text-decoration: none; color: var(--muted-2); transition: color 160ms; }
.nav-links a:hover { color: var(--text); }
.nav-cta { height: 46px; padding: 0 22px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--forest); color: #FFFFFF; font-weight: 700; font-size: 15.5px; text-decoration: none; }
.nav-cta:hover { background: #135A40; }
@media (max-width: 860px) { .nav-links { display: none; } .nav-cta { margin-left: auto; } }

/* ---------- Hero ---------- */
.hero { position: relative; min-height: clamp(680px, 92svh, 920px); display: grid; place-items: center; padding: 40px 16px 80px; }
.discs { position: absolute; inset: 0; pointer-events: none; }
.disc { position: absolute; top: var(--y); width: var(--s); height: var(--s); margin-top: calc(var(--s) / -2); will-change: transform; }
.disc-l { left: var(--x); }
.disc-r { right: var(--x); }
.disc-in {
  width: 100%; height: 100%; border-radius: 50%; display: grid; place-items: center; background: var(--tone); color: var(--ink);
  box-shadow: 0 24px 50px -14px color-mix(in srgb, var(--tone) 70%, transparent), 0 6px 14px rgba(16, 32, 24, 0.08);
  animation: bob 7s ease-in-out infinite alternate;
}
.disc:nth-child(2n) .disc-in { animation-duration: 9s; animation-delay: -3s; }
.disc:nth-child(3n) .disc-in { animation-duration: 8s; animation-delay: -5s; }
.disc-in .i { width: 52%; height: 52%; }
.disc-moni { width: 82%; height: 82%; margin-top: 6%; }
@keyframes bob { from { transform: translateY(-9px) rotate(-3deg); } to { transform: translateY(9px) rotate(3deg); } }
.hero-copy { position: relative; max-width: 860px; text-align: center; display: flex; flex-direction: column; align-items: center; }
.hero h1 { font-size: clamp(50px, 7.4vw, 112px); line-height: 0.98; text-wrap: balance; }
.hero h1 span { display: block; }
.lead { margin-top: 28px; max-width: 33em; font-size: clamp(17px, 1.5vw, 19px); color: var(--muted-2); text-wrap: pretty; }
.btn-forest { margin-top: 36px; height: 60px; padding: 0 34px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--forest); color: #FFFFFF; font-weight: 700; font-size: 18px; text-decoration: none; box-shadow: 0 16px 30px -10px rgba(14, 74, 52, 0.55); }
.btn-forest:hover { background: #135A40; box-shadow: 0 20px 36px -10px rgba(14, 74, 52, 0.6); }
.soon { margin-top: 30px; color: var(--muted); font-size: 15px; }
.platforms { margin-top: 12px; display: flex; gap: 10px; }
.platforms li { height: 48px; padding: 0 18px; display: inline-flex; align-items: center; gap: 8px; border-radius: 16px; border: 1px solid var(--line); font-weight: 600; font-size: 15.5px; color: var(--muted-2); }
.platforms .i { width: 20px; height: 20px; color: var(--text); }

/* ---------- The app window ---------- */
.window-wrap { padding: 0 16px; }
.window { max-width: 1160px; margin: 0 auto; border-radius: 40px; background: var(--panel); border: 1px solid var(--line); padding: 64px 32px 0; overflow: hidden; box-shadow: 0 50px 100px -40px rgba(16, 32, 24, 0.28); }
.phones { display: flex; justify-content: center; align-items: flex-end; gap: 28px; }
.phone { flex: none; width: 290px; border-radius: 46px 46px 0 0; padding: 10px 10px 0; background: #17201B; box-shadow: 0 30px 60px -20px rgba(16, 32, 24, 0.35); }
.p-mid { width: 310px; position: relative; z-index: 1; }
.p-left, .p-right { margin-bottom: -60px; }
.scr { height: 560px; border-radius: 37px 37px 0 0; background: #F1F2EE; overflow: hidden; padding: 0 14px; font-size: 12.5px; line-height: 1.3; display: flex; flex-direction: column; gap: 8px; }
.p-mid .scr { height: 600px; }
.st { height: 36px; flex: none; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; font-weight: 700; font-size: 13px; }
.bat { width: 20px; height: 10px; border-radius: 3px; border: 1.5px solid currentColor; position: relative; }
.bat::after { content: ""; position: absolute; inset: 1.5px 4px 1.5px 1.5px; background: currentColor; border-radius: 1px; }
.hd { display: flex; align-items: center; justify-content: space-between; }
.hd b { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
.hd-c { display: grid; grid-template-columns: 22px 1fr 22px; text-align: center; }
.hd-c b { font-size: 14.5px; font-weight: 700; letter-spacing: 0; }
.hd-c .i { width: 22px; height: 22px; }
.spill { height: 30px; padding: 0 10px; display: inline-flex; align-items: center; gap: 3px; border-radius: 999px; background: #FFFFFF; font-weight: 700; color: var(--text); }
.spill .i { width: 16px; height: 16px; color: var(--orange); }
.wal { display: flex; gap: 8px; margin-right: -14px; }
.wal div { flex: none; width: 140px; height: 92px; border-radius: 18px; padding: 12px; color: #FFFFFF; display: flex; flex-direction: column; justify-content: flex-end; }
.wal span { font-size: 11px; color: rgba(255, 255, 255, 0.86); }
.wal b { font-size: 16px; font-weight: 800; }
.lb { margin-top: 6px; font-size: 13px; font-weight: 700; }
.ch { display: flex; gap: 6px; overflow: hidden; }
.ch span { height: 30px; padding: 0 10px; display: inline-flex; align-items: center; gap: 4px; flex: none; border-radius: 999px; background: #FFFFFF; border: 1px solid var(--line); font-size: 12px; font-weight: 600; }
.ch .i { width: 14px; height: 14px; }
.ch .sel { background: var(--forest); border-color: var(--forest); color: #FFFFFF; }
.rw { display: flex; flex-direction: column; gap: 6px; }
.rw li { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 8px; border-radius: 14px; background: #FFFFFF; }
.rw small { display: block; color: var(--muted); font-size: 11px; }
.rw b { font-weight: 700; font-variant-numeric: tabular-nums; }
.rw .o { color: #B8433A; font-weight: 800; }
.rw .n { color: #1F7A44; font-weight: 800; }
.bd { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; flex: none; }
.bd .i { width: 16px; height: 16px; }
.grp-hero { background: var(--forest); color: #FFFFFF; border-radius: 22px; padding: 16px; display: flex; flex-direction: column; }
.grp-hero span, .grp-hero small { color: #9FC2B1; font-size: 12px; }
.grp-hero b { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
.settle { display: flex; flex-direction: column; gap: 6px; }
.settle li { display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-radius: 14px; background: #FFFFFF; font-weight: 600; }
.settle .i { width: 14px; height: 14px; color: var(--muted); }
.settle b { margin-left: auto; font-weight: 800; font-variant-numeric: tabular-nums; }
.av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 11.5px; flex: none; }
.sg { display: grid; grid-template-columns: repeat(3, 1fr); padding: 3px; border-radius: 999px; background: var(--panel-2); text-align: center; font-size: 11.5px; font-weight: 600; color: var(--muted); }
.sg span { height: 28px; display: grid; place-items: center; border-radius: 999px; }
.sg .on { background: #F1A094; color: var(--forest-deep); font-weight: 700; }
.am { display: flex; align-items: baseline; justify-content: center; gap: 8px; padding: 14px 0 6px; }
.am small { color: var(--muted); font-weight: 700; }
.am b { font-size: 38px; font-weight: 800; color: var(--red); letter-spacing: -0.02em; }
.kp { margin-top: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.kp span { height: 44px; border-radius: 14px; background: #FFFFFF; display: grid; place-items: center; font-size: 18px; font-weight: 700; }
.kp .i { width: 20px; height: 20px; color: var(--muted); }
.sv { margin: 6px 0 60px; height: 44px; border-radius: 999px; display: grid; place-items: center; background: var(--forest); color: #FFFFFF; font-weight: 700; }
.window-cap { margin-top: 18px; text-align: center; color: var(--muted); font-size: 14.5px; }

/* ---------- Alternating rows with bubbles ---------- */
.rows { max-width: 1160px; margin: 0 auto; padding: 160px 16px 0; scroll-margin-top: 60px; }
.rows .mixed { margin-bottom: 104px; }
.feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 48px 72px; align-items: center; }
.feature + .feature { margin-top: 128px; }
.feature.flip .feature-copy { order: 2; }
.feature-copy h3 { font-size: clamp(32px, 3.6vw, 48px); line-height: 1.05; font-weight: 800; letter-spacing: -0.035em; text-wrap: balance; }
.feature-copy p { margin-top: 20px; max-width: 30em; color: var(--muted-2); font-size: 18px; text-wrap: pretty; }
.panel { position: relative; min-height: 380px; border-radius: 36px; background: var(--panel); border: 1px solid var(--line); padding: 36px 40px; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
.panel-title { font-weight: 700; color: var(--muted); font-size: 15px; margin: -8px 0 2px; }
.bubble { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 14px 18px; border-radius: 22px; font-size: 15px; line-height: 1.3; transform: rotate(var(--r, 0)); box-shadow: 0 14px 30px -14px rgba(16, 32, 24, 0.28); max-width: 400px; }
.bubble small { display: block; font-size: 13px; opacity: 0.8; }
.bubble b { font-weight: 700; }
.bubble > .num, .bubble .o { font-weight: 800; font-variant-numeric: tabular-nums; }
.bubble .bd { width: 40px; height: 40px; background: rgba(255, 255, 255, 0.65); }
.bubble .bd .i { width: 20px; height: 20px; }
.b-yellow { background: #FBF1D0; color: #5C4806; }
.b-yellow .bd { color: #85680A; }
.b-blue { background: #DCEAF7; color: #133F66; }
.b-blue .bd { color: #1F5F9A; }
.b-green { background: #DDF3E4; color: #145230; }
.b-green .bd { color: #1F7A44; }
.b-orange { background: #FCE8D6; color: #6E3B10; }
.b-white { background: #FFFFFF; color: var(--text); }
.b-forest { background: var(--forest); color: #FFFFFF; grid-template-columns: 24px minmax(0, 1fr); box-shadow: 0 18px 34px -14px rgba(14, 74, 52, 0.6); }
.b-forest .i { width: 24px; height: 24px; color: #B6EB7D; }
.b-forest small { color: #B5D3C4; opacity: 1; }
.shift-r { margin-left: 56px; }
.shift-l { margin-left: 18px; }
.out-r { align-self: flex-end; margin-right: -64px; }
.out-l { align-self: flex-start; margin-left: -56px; }
.wide { max-width: none; }
.share-row { display: flex; flex-direction: column; gap: 10px; padding-left: 28px; }
.share { grid-template-columns: 32px minmax(0, 1fr) auto; max-width: 320px; }
.share .av { width: 32px; height: 32px; background: rgba(255, 255, 255, 0.7); font-size: 13px; }
.share:nth-child(2) { margin-left: 44px; }
.share:nth-child(3) { margin-left: 16px; }
.modes { margin-top: 28px; display: inline-flex; gap: 4px; padding: 5px; border-radius: 999px; background: var(--panel); border: 1px solid var(--line); }
.modes button { height: 42px; padding: 0 18px; border-radius: 999px; font-weight: 700; font-size: 15px; color: var(--muted-2); }
.modes button:hover { color: var(--text); }
.modes [aria-pressed="true"] { background: #FFFFFF; color: var(--forest); box-shadow: 0 1px 3px rgba(16, 32, 24, 0.12); }
.eye { margin-top: 28px; height: 46px; padding: 0 18px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--panel); border: 1px solid var(--line); font-weight: 700; font-size: 15px; }
.eye:hover { background: var(--panel-2); }
.wallets-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-content: center; padding: 48px 40px; }
.wallet { height: 128px; border-radius: 24px; padding: 16px; color: #FFFFFF; display: flex; flex-direction: column; transform: rotate(var(--r)); box-shadow: 0 20px 36px -14px rgba(16, 32, 24, 0.4); }
.wallet:nth-child(2) { margin-top: 28px; margin-right: -40px; }
.wallet:nth-child(3) { margin-left: -36px; }
.w-ico { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: rgba(255, 255, 255, 0.2); }
.w-ico .i { width: 18px; height: 18px; }
.w-name { margin-top: auto; font-size: 13px; color: rgba(255, 255, 255, 0.88); }
.w-bal { font-size: 21px; font-weight: 800; font-variant-numeric: tabular-nums; }
.w-bal i { display: none; font-style: normal; letter-spacing: 0.1em; }
.hide-amounts .w-bal span { display: none; }
.hide-amounts .w-bal i { display: inline; }
.js-pop .pop { opacity: 0; transform: translateY(24px) scale(0.92) rotate(var(--r, 0)); }
.js-pop .popped .pop { opacity: 1; transform: rotate(var(--r, 0)); transition: opacity 500ms var(--ease), transform 700ms var(--ease); }

/* ---------- Forest slab ---------- */
.slab-wrap { padding: 160px 16px 0; scroll-margin-top: 40px; }
.slab { position: relative; max-width: 1240px; margin: 0 auto; border-radius: 44px; background: var(--forest); color: #FFFFFF; padding: 104px 48px 72px; text-align: center; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; align-items: center; }
.swoosh { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
.slab h2 { font-size: clamp(36px, 5vw, 68px); line-height: 1.02; font-weight: 500; letter-spacing: -0.035em; max-width: 13em; text-wrap: balance; }
.slab h2 span { font-weight: 800; letter-spacing: -0.04em; }
.slab > p { margin-top: 20px; max-width: 32em; color: var(--on-forest-muted); font-size: 18px; }
.rec-pills { margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 760px; }
.rec-pills li { height: 52px; padding: 0 20px; display: inline-flex; align-items: center; gap: 8px; border-radius: 18px; background: #FFFFFF; color: var(--text); font-weight: 700; font-size: 16px; box-shadow: 0 14px 26px -14px rgba(0, 0, 0, 0.5); }
.rec-pills .i { color: var(--forest); }
.rec-card { margin-top: 48px; width: min(560px, 100%); padding: 16px; border-radius: 28px; background: #F1F2EE; color: var(--text); text-align: left; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.55); }
.rec-head { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px; border-radius: 18px; background: #FFFFFF; }
.rec-head .bd { width: 40px; height: 40px; }
.rec-head small { display: block; color: var(--muted); font-size: 13px; }
.rec-head .num { font-weight: 800; font-size: 18px; }
.statuses { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.statuses li { display: grid; grid-template-columns: 28px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 10px; row-gap: 4px; align-items: center; padding: 10px 12px; border-radius: 16px; background: #FFFFFF; }
.statuses .av { width: 28px; height: 28px; grid-row: span 2; }
.statuses b { font-size: 14.5px; }
.tag { justify-self: start; height: 24px; padding: 0 9px; display: inline-flex; align-items: center; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; }

/* ---------- Tinted cards ---------- */
.cards-sec { max-width: 1240px; margin: 0 auto; padding: 160px 16px 0; }
.cards-sec .mixed { margin-bottom: 72px; }
.tcards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
.tcard { min-height: 460px; border-radius: 40px; background: var(--bg); padding: 44px 44px 0; display: flex; flex-direction: column; overflow: hidden; scroll-margin-top: 90px; }
.tcard h3 { font-size: 28px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
.tcard > p { margin-top: 12px; max-width: 30em; color: color-mix(in srgb, var(--ink) 55%, #17201B); font-size: 16.5px; }
.tvis { margin-top: auto; padding: 36px 0 44px; display: flex; align-items: center; gap: 18px; }
.habit .moni { width: 120px; height: 120px; flex: none; filter: drop-shadow(0 14px 18px rgba(16, 32, 24, 0.18)); }
.habit-ui { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
.pills { display: flex; gap: 8px; flex-wrap: wrap; }
.pill { height: 38px; padding: 0 14px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; background: #FFFFFF; font-weight: 700; font-size: 14.5px; }
.pill .i { width: 18px; height: 18px; }
.week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; height: 92px; align-items: end; }
.week i { display: block; height: var(--h); border-radius: 8px; background: rgba(255, 255, 255, 0.75); }
.week .today { background: var(--ink); }
.week .fut { background: rgba(255, 255, 255, 0.4); }
.group { flex-direction: column; align-items: stretch; gap: 12px; }
.invite { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 22px; background: #FFFFFF; }
.label { display: block; color: var(--muted); font-size: 11.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
.code { display: block; font-size: 28px; font-weight: 800; letter-spacing: 0.14em; line-height: 1.2; color: var(--forest); }
.valid { color: var(--muted); font-size: 12.5px; }
.copy { margin-left: auto; height: 40px; padding: 0 16px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; background: var(--forest); color: #FFFFFF; font-size: 14.5px; font-weight: 700; }
.copy:hover { background: #135A40; }
.copy .i { width: 16px; height: 16px; }
.activity { display: flex; flex-direction: column; gap: 8px; }
.activity li { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 18px; background: rgba(255, 255, 255, 0.6); font-weight: 600; font-size: 14.5px; color: #24402F; }
.themes { gap: 14px; }
.mm { flex: 1; min-width: 0; border-radius: 22px; padding: 16px; display: flex; flex-direction: column; gap: 4px; box-shadow: 0 16px 30px -16px rgba(16, 32, 24, 0.35); }
.mm span { font-size: 12.5px; font-weight: 700; }
.mm b { font-size: 18px; font-weight: 800; font-variant-numeric: tabular-nums; }
.mm-day { background: #FFFFFF; color: #17201B; transform: rotate(-3deg); }
.mm-day span { color: #66706A; }
.mm-day .in { color: #1F7A44; }
.mm-day .out { color: #B8433A; }
.mm-night { background: #151D19; color: #E8EFEA; transform: rotate(3deg) translateY(10px); }
.mm-night span { color: #A3AEA7; }
.mm-night .in { color: #74D69B; }
.mm-night .out { color: #FF9A8F; }
.mm-bar { margin-top: 10px; display: flex; gap: 2px; height: 8px; border-radius: 999px; overflow: hidden; }
.mm-bar i { display: block; }
.privacy { gap: 22px; }
.lock { width: 96px; height: 96px; flex: none; border-radius: 50%; display: grid; place-items: center; background: #8B5CD6; color: #17201B; box-shadow: 0 22px 40px -14px rgba(139, 92, 214, 0.7); }
.lock .i { width: 48px; height: 48px; }
.checks { display: flex; flex-direction: column; gap: 10px; }
.checks li { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; }
.checks .i { width: 18px; height: 18px; color: var(--ink); }

/* ---------- Blog ---------- */
.blog { max-width: 1160px; margin: 0 auto; padding: 150px 16px 0; }
.blog-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
.blog h2 { font-size: 30px; font-weight: 800; letter-spacing: -0.03em; }
.blog-head a { display: inline-flex; align-items: center; gap: 6px; color: var(--forest); font-weight: 700; text-decoration: none; }
.blog-head a:hover { text-decoration: underline; text-underline-offset: 4px; }
.blog-head .i { width: 18px; height: 18px; }
.posts li { border-top: 1px solid var(--line); }
.post { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 20px; align-items: center; padding: 24px 0; text-decoration: none; }
.post-disc { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: #17201B; transition: transform 300ms var(--ease); }
.post-disc .i { width: 26px; height: 26px; }
.post:hover .post-disc { transform: scale(1.08) rotate(-6deg); }
.post-main { display: flex; flex-direction: column; gap: 4px; }
.post-main b { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
.post:hover .post-main b { color: var(--forest); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
.post-main span { color: var(--muted); font-size: 15.5px; max-width: 64ch; }
.post time { color: var(--muted); font-size: 14px; font-weight: 600; white-space: nowrap; }

/* ---------- Close ---------- */
.close { position: relative; max-width: 1160px; margin: 0 auto; padding: 200px 16px 120px; text-align: center; display: flex; flex-direction: column; align-items: center; }
.close > p { margin-top: 20px; color: var(--muted-2); font-size: 18px; }
.cdisc { position: absolute; border-radius: 50%; display: grid; place-items: center; background: var(--tone, transparent); color: #17201B; animation: bob 8s ease-in-out infinite alternate; }
.cdisc .i { width: 52%; height: 52%; }
.c1 { width: 130px; height: 130px; left: 8%; top: 120px; }
.c1 svg { width: 100%; height: 100%; }
.c2 { width: 92px; height: 92px; right: 12%; top: 150px; box-shadow: 0 20px 36px -14px rgba(214, 81, 122, 0.6); animation-delay: -3s; }
.c3 { width: 110px; height: 110px; right: 4%; bottom: 120px; box-shadow: 0 20px 36px -14px rgba(31, 163, 150, 0.6); animation-delay: -5s; }
.stores { margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
.store { height: 60px; padding: 0 22px 0 16px; display: inline-flex; align-items: center; gap: 12px; border-radius: 18px; background: var(--panel); border: 1px solid var(--line); text-align: left; }
.store .i { width: 26px; height: 26px; }
.store small { display: block; color: var(--muted); font-size: 12px; font-weight: 600; }
.store b { font-size: 17px; font-weight: 700; line-height: 1.1; }
.foot { max-width: 1160px; margin: 0 auto; padding: 32px 16px 56px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: var(--muted); font-size: 14px; }
.foot nav { display: flex; gap: 20px; }
.foot a { text-decoration: none; font-weight: 700; color: var(--muted-2); }
.foot a:hover { color: var(--text); }

/* ---------- Responsive ---------- */
@media (max-width: 1100px) {
  .disc { --s-scale: 0.72; width: calc(var(--s) * 0.72); height: calc(var(--s) * 0.72); margin-top: calc(var(--s) * -0.36); }
  .disc-l { left: calc(var(--x) - 4%); }
  .disc-r { right: calc(var(--x) - 4%); }
  .p-left, .p-right { display: none; }
}
@media (max-width: 860px) {
  .hero { min-height: 0; padding: 230px 16px 72px; place-items: start center; }
  .disc { top: 0; margin-top: 0; width: calc(var(--s) * 0.42); height: calc(var(--s) * 0.42); }
  .disc:nth-child(1) { left: 4%; top: 20px; }
  .disc:nth-child(2) { left: 24%; top: 92px; }
  .disc:nth-child(3) { left: 2%; top: 140px; }
  .disc:nth-child(4) { right: 26%; top: 14px; }
  .disc:nth-child(5) { right: 3%; top: 60px; }
  .disc:nth-child(6) { right: 30%; top: 128px; }
  .feature, .feature.flip { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .feature.flip .feature-copy { order: 0; }
  .feature + .feature { margin-top: 96px; }
  .rows { padding-top: 112px; }
  .rows .mixed { margin-bottom: 64px; }
  .panel { padding: 28px 20px; min-height: 0; border-radius: 30px; }
  .out-r { margin-right: -8px; }
  .out-l { margin-left: -8px; }
  .shift-r { margin-left: 28px; }
  .share-row { padding-left: 0; }
  .share:nth-child(2) { margin-left: 24px; }
  .wallets-panel { padding: 32px 20px; gap: 12px; }
  .wallet { height: 112px; padding: 12px; }
  .wallet:nth-child(2) { margin-right: 0; }
  .wallet:nth-child(3) { margin-left: 0; }
  .w-bal { font-size: 17px; }
  .w-name { font-size: 11.5px; }
  .slab-wrap, .cards-sec { padding-top: 112px; }
  .slab { padding: 72px 20px 24px; border-radius: 32px; }
  .rec-pills li { height: 44px; padding: 0 14px; font-size: 14.5px; border-radius: 14px; }
  .tcards { grid-template-columns: minmax(0, 1fr); }
  .tcard { min-height: 0; padding: 32px 24px 0; border-radius: 32px; }
  .tvis { padding: 28px 0 32px; }
  .themes { flex-direction: column; }
  .mm { width: 100%; }
  .privacy { flex-direction: column; align-items: flex-start; }
  .blog { padding-top: 112px; }
  .post { grid-template-columns: 48px minmax(0, 1fr); gap: 16px; }
  .post-disc { width: 48px; height: 48px; }
  .post time { grid-column: 2; }
  .close { padding: 170px 16px 96px; }
  .c1 { width: 92px; height: 92px; left: 4%; top: 40px; }
  .c2 { width: 64px; height: 64px; right: 10%; top: 60px; }
  .c3 { display: none; }
  .window { padding: 40px 16px 0; border-radius: 32px; }
  .p-mid { width: min(300px, 100%); }
}
@media (max-width: 420px) { .statuses { grid-template-columns: minmax(0, 1fr); } .modes button { padding: 0 13px; } }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .disc-in, .cdisc { animation: none; }
  .js-pop .pop { opacity: 1; transform: rotate(var(--r, 0)); }
  .nav, .nav-wrap { transition: none; }
}
</style>

<script is:inline>
(() => {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
  const money = (v) => '$ ' + fmt.format(Math.round(v));

  /* Nav turns into a floating pill once the page leaves the top. */
  const navWrap = document.getElementById('navWrap');
  new IntersectionObserver(([e]) => navWrap.classList.toggle('floating', !e.isIntersecting)).observe(document.querySelector('.nav-sentinel'));

  /* Discs drift with scroll and pointer, each at its own depth. */
  const discs = [...document.querySelectorAll('.disc')];
  if (!reduceMotion && discs.length) {
    let px = 0, py = 0, raf = 0;
    const paint = () => {
      raf = 0;
      const sy = Math.min(scrollY, 900);
      discs.forEach((d) => {
        const k = Number(d.dataset.depth);
        d.style.transform = 'translate3d(' + (px * 18 * k).toFixed(1) + 'px,' + (py * 14 * k - sy * 0.22 * k).toFixed(1) + 'px,0)';
      });
    };
    const ask = () => { if (!raf) raf = requestAnimationFrame(paint); };
    addEventListener('scroll', ask, { passive: true });
    addEventListener('pointermove', (e) => { px = e.clientX / innerWidth - 0.5; py = e.clientY / innerHeight - 0.5; ask(); }, { passive: true });
  }

  /* Bubbles and cards pop out of each panel once, as it enters. */
  if (!reduceMotion && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-pop');
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      e.target.querySelectorAll('.pop').forEach((p, i) => { p.style.transitionDelay = i * 110 + 'ms'; });
      e.target.classList.add('popped');
    }), { threshold: 0.35 });
    document.querySelectorAll('[data-pop]').forEach((el) => io.observe(el));
  }

  /* Split modes */
  const tweens = new WeakMap();
  function tween(el, from, to, format, duration = 450) {
    cancelAnimationFrame(tweens.get(el));
    if (reduceMotion || from === to) { el.textContent = format(to); return; }
    const start = performance.now();
    const step = (now) => {
      const t = Math.min(1, (now - start) / duration);
      el.textContent = format(from + (to - from) * (1 - Math.pow(1 - t, 4)));
      if (t < 1) tweens.set(el, requestAnimationFrame(step));
    };
    tweens.set(el, requestAnimationFrame(step));
  }
  const total = 48300;
  const modes = {
    equal: { values: [1, 1, 1], detail: () => 'Un tercio' },
    shares: { values: [2, 1, 1], detail: (v) => v + (v === 1 ? ' parte' : ' partes') },
    percentage: { values: [40, 30, 30], detail: (v) => v + '%' },
    amount: { values: [18300, 15000, 15000], detail: () => 'Importe fijo' },
  };
  const split = (mode) => {
    const { values } = modes[mode];
    if (mode === 'amount') return values.slice();
    const sum = values.reduce((a, b) => a + b, 0);
    return values.map((v) => (total * v) / sum);
  };
  let shares = split('equal');
  const owed = document.getElementById('owed');
  document.getElementById('splitSeg').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-mode]');
    if (!btn) return;
    const mode = btn.dataset.mode;
    document.querySelectorAll('#splitSeg button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    const next = split(mode);
    document.querySelectorAll('.share .detail').forEach((d, i) => { d.textContent = modes[mode].detail(modes[mode].values[i]); });
    document.querySelectorAll('.share [data-share]').forEach((el) => {
      const i = Number(el.dataset.share);
      tween(el, shares[i], next[i], money);
    });
    tween(owed, total - shares[0], total - next[0], (v) => 'Te deben ' + money(v));
    shares = next;
  });

  /* Hide amounts */
  const eye = document.getElementById('eye');
  eye.addEventListener('click', () => {
    const hidden = eye.getAttribute('aria-pressed') !== 'true';
    eye.setAttribute('aria-pressed', String(hidden));
    document.getElementById('walletsPanel').classList.toggle('hide-amounts', hidden);
    document.getElementById('eyeText').textContent = hidden ? 'Mostrar montos' : 'Ocultar montos';
  });

  /* Copy invite code */
  const copyText = document.getElementById('copyText');
  document.getElementById('copy').addEventListener('click', async () => {
    const code = document.getElementById('code');
    try { await navigator.clipboard.writeText(code.textContent); copyText.textContent = 'Copiado'; }
    catch { const r = document.createRange(); r.selectNodeContents(code); const s = getSelection(); s.removeAllRanges(); s.addRange(r); copyText.textContent = 'Seleccionado'; }
    setTimeout(() => { copyText.textContent = 'Copiar'; }, 1600);
  });
})();
</script>
</Variant>

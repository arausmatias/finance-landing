.why-fx { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; align-self: center; min-height: 52px; }
.fx-taps { flex-wrap: nowrap; gap: 6px; }
.fx-taps span { height: 38px; padding: 0 12px; white-space: nowrap; display: inline-flex; align-items: center; border-radius: 999px; background: var(--surface); border: 1px solid var(--line-2); font-size: 14.5px; font-weight: 700; }
.fx-taps span.lit { background: var(--brand); border-color: var(--brand); color: #FFFFFF; }
.fx-taps > .i { width: 16px; height: 16px; color: var(--line-2); }
.ok { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--green-soft); color: var(--green-ink); }
.ok .i { width: 20px; height: 20px; }
.lock { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); }
.lock .i { width: 26px; height: 26px; }
.strike { position: relative; height: 38px; padding: 0 14px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--canvas); font-size: 14.5px; font-weight: 700; color: var(--muted-2); }
.strike i { position: absolute; left: 10px; right: 10px; top: 50%; height: 2px; border-radius: 2px; background: var(--expense-text); transform-origin: 0 50%; }
.fx-people { position: relative; height: 52px; }
.fx-people .avatar { width: 44px; height: 44px; font-size: 17px; box-shadow: 0 0 0 3px var(--page); }
.fx-people .avatar + .avatar { margin-left: -12px; }
.fx-pill { margin-left: 8px; height: 38px; padding: 0 14px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--green-soft); color: var(--green-ink); font-size: 14.5px; font-weight: 700; }
@media (min-width: 900px) {
  .why-row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; padding: 40px 0 44px; }
}

/* ---------- How it works ---------- */
.how-wrap { max-width: 1240px; }
.how { border-radius: 40px; background: var(--canvas); padding: 48px 16px 16px; }
.how-grid { display: grid; gap: 24px; }
.how-steps { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.hstep { position: relative; display: flex; gap: 12px; align-items: flex-start; text-align: left; padding: 14px; border-radius: 20px; overflow: hidden; }
.hstep:hover { background: rgba(255, 255, 255, 0.6); }
.hstep.is-on { background: var(--surface); box-shadow: 0 1px 3px rgba(16, 32, 24, 0.06); }
.hn { width: 30px; height: 30px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--surface-alt); font-size: 14px; font-weight: 800; color: var(--muted-2); transition: background-color 200ms, color 200ms; }
.hstep.is-on .hn { background: var(--brand); color: #FFFFFF; }
.ht { display: grid; gap: 2px; }
.ht b { font-size: 17px; font-weight: 800; }
.ht span { display: none; color: var(--muted); font-size: 14.5px; line-height: 1.4; }
.hbar { position: absolute; left: 14px; right: 14px; bottom: 0; height: 3px; border-radius: 3px; background: transparent; overflow: hidden; }
.hbar i { display: block; height: 100%; width: 100%; background: var(--brand); transform: scaleX(0); transform-origin: 0 50%; }
.how-stage { position: relative; border-radius: 28px; background: var(--surface); padding: 64px 0 16px; box-shadow: 0 30px 60px -36px rgba(16, 32, 24, 0.35); }
.how-stage > .pause { position: absolute; right: 14px; top: 12px; z-index: 2; }
.how-stage .fit { max-width: 400px; }
@media (min-width: 720px) { .how { padding: 72px 48px 48px; } .how-steps { grid-template-columns: repeat(4, 1fr); } .hstep.is-on .ht span { display: block; } .ht span { display: block; } }
@media (min-width: 1040px) {
  .how-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .how-steps { grid-template-columns: 1fr; gap: 6px; }
  .hstep { padding: 18px 18px 20px; }
}

/* The stage: a 400x440 scene */
.stage { width: 400px; height: 440px; font-size: 15px; }
.stage > *, .split-ui > * { position: absolute; }
.amt-disp { left: 0; right: 0; top: 6px; display: flex; flex-direction: column; align-items: center; }
.amt-disp small { font-size: 13px; font-weight: 700; color: var(--muted); }
.amt-disp b { font-size: 46px; line-height: 1.1; font-weight: 800; letter-spacing: -0.03em; color: var(--expense-text); }
.amt-disp .caret { position: absolute; display: none; }
.s-chips { left: 0; right: 0; top: 100px; display: flex; justify-content: center; gap: 8px; }
.s-chip { height: 38px; padding: 0 14px 0 10px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 14.5px; font-weight: 600; }
.s-chip .i { width: 18px; height: 18px; color: var(--orange); }
.s-chip.sel { background: var(--brand); border-color: var(--brand); color: #FFFFFF; }
.s-chip.sel .i { color: #FFFFFF; }
.kp { left: 48px; top: 152px; width: 304px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.kp span { height: 42px; border-radius: 14px; background: var(--canvas); display: grid; place-items: center; font-size: 20px; font-weight: 700; }
.kp .i { width: 22px; height: 22px; color: var(--muted); }
.s-save { left: 48px; top: 364px; width: 304px; height: 50px; border-radius: 999px; background: var(--brand); color: #FFFFFF; display: grid; place-items: center; font-weight: 700; }
.token { left: 10px; top: 24px; width: 380px; height: 68px; padding: 0 16px; display: flex; align-items: center; gap: 12px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); box-shadow: 0 14px 30px -12px rgba(16, 32, 24, 0.28); opacity: 0; visibility: hidden; }
.token .row-main b { font-size: 16px; }
.month { left: 10px; top: 112px; width: 380px; opacity: 0; visibility: hidden; }
.m-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.m-head span { color: var(--muted); font-size: 14px; font-weight: 700; }
.m-head b { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
.m-bar { margin: 12px 0 14px; height: 14px; border-radius: 999px; background: var(--surface-alt); display: flex; overflow: hidden; }
.m-bar i { height: 100%; }
.m-bar i + i { border-left: 2px solid #FFFFFF; }
.m-list { display: grid; gap: 4px; }
.m-list li { display: flex; align-items: center; gap: 12px; height: 50px; padding: 0 10px; border-radius: 14px; }
.m-list li b:first-of-type { flex: 1; font-weight: 700; }
.split-ui { inset: 0; opacity: 0; visibility: hidden; }
.seg4 { display: flex; padding: 4px; border-radius: 999px; background: var(--surface-alt); font-size: 14px; font-weight: 700; color: var(--muted-2); }
.seg4 > span { position: relative; z-index: 1; flex: 1; height: 34px; display: grid; place-items: center; border-radius: 999px; }
.seg4 .on { background: var(--surface); color: var(--brand); box-shadow: 0 1px 3px rgba(16, 32, 24, 0.08); }
.split-ui .seg4 { left: 10px; top: 108px; width: 380px; }
.ppl { left: 44px; top: 168px; width: 346px; display: grid; gap: 8px; }
.ppl li { height: 48px; display: flex; align-items: center; gap: 12px; padding: 0 10px; border-radius: 14px; background: var(--canvas); font-weight: 700; }
.ppl li b { flex: 1; }
.tag { height: 28px; padding: 0 10px; display: inline-flex; align-items: center; gap: 4px; border-radius: 999px; background: var(--brand-soft); color: var(--brand); font-size: 13px; font-weight: 700; white-space: nowrap; }
.tag .i { width: 14px; height: 14px; }
.tag.ok { background: var(--green-soft); color: var(--green-ink); opacity: 0; }
#sTagV { margin-right: 96px; opacity: 0; }
.arrows { left: 0; top: 0; width: 400px; height: 440px; overflow: visible; }
.arrows path { fill: none; stroke: var(--green); stroke-width: 2.5; stroke-linecap: butt; stroke-dasharray: 1 2; stroke-dashoffset: 1; }
.owed { left: 10px; top: 348px; width: 380px; height: 64px; padding: 0 18px; display: flex; align-items: center; justify-content: space-between; border-radius: 18px; background: var(--green-soft); color: var(--green-ink); font-weight: 700; }
.owed b { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
.done { left: 10px; top: 348px; width: 380px; height: 64px; display: flex; align-items: center; justify-content: center; gap: 10px; border-radius: 18px; background: var(--brand); color: #FFFFFF; font-size: 18px; font-weight: 800; opacity: 0; visibility: hidden; }
.done svg { width: 44px; height: 44px; }
.fly { left: 286px; height: 30px; padding: 0 10px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--surface); border: 1px solid var(--line-2); font-size: 14px; font-weight: 800; opacity: 0; visibility: hidden; }
#sFlyV { top: 177px; } #sFlyS { top: 233px; } #sFlyT { top: 289px; }

/* ---------- What's new ---------- */
.news { display: grid; gap: 16px; }
.news-card { display: grid; grid-template-rows: auto 1fr; clip-path: inset(0% 0% 0% 0% round 28px); border-radius: 28px; background: var(--surface); border: 1px solid var(--line); overflow: hidden; }
.nc-top { padding: 24px 24px 20px; display: grid; gap: 8px; align-content: start; }
.date { justify-self: start; height: 28px; padding: 0 10px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; background: var(--soft); color: var(--ink); font-size: 13px; font-weight: 800; }
.dot-new { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.news-card h3 { font-size: 24px; line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; }
.news-card p { color: var(--muted-2); font-size: 16px; max-width: 52ch; }
.nc-vis { position: relative; margin: 0 12px 12px; border-radius: 20px; background: var(--soft); padding: 20px; min-height: 196px; overflow: hidden; }
/* reports */
.rep-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; }
.rep-tabs { display: flex; padding: 3px; border-radius: 999px; background: rgba(255, 255, 255, 0.6); font-size: 13px; font-weight: 700; color: var(--muted-2); }
.rep-tabs span { height: 30px; padding: 0 12px; display: grid; place-items: center; border-radius: 999px; }
.rep-tabs .on { background: #FFFFFF; color: var(--brand); }
.rep-cmp { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; white-space: nowrap; font-size: 14px; font-weight: 700; color: var(--muted-2); }
.rep-cmp b { color: var(--text); font-weight: 800; }
.rep-cmp em { font-style: normal; display: inline-flex; align-items: center; gap: 2px; height: 26px; padding: 0 8px 0 4px; border-radius: 999px; background: #FFFFFF; color: var(--green-ink); }
.rep-cmp em .i { width: 16px; height: 16px; }
.rep-chart { margin-top: 18px; overflow: hidden; }
.rep-track { display: flex; gap: 12px; height: 190px; align-items: flex-end; }
.rb { flex: 0 0 calc((100% - 36px) / 4); height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 6px; }
.rb i { width: 100%; height: calc(var(--h) * 156px); border-radius: 12px 12px 6px 6px; background: rgba(31, 95, 154, 0.22); transform-origin: 50% 100%; }
.rb.sel i { background: var(--blue-ink); }
.rb.proj i { background: repeating-linear-gradient(-45deg, rgba(31, 95, 154, 0.18) 0 6px, rgba(31, 95, 154, 0.06) 6px 12px); box-shadow: inset 0 0 0 1.5px rgba(31, 95, 154, 0.45); }
.rb small { font-size: 12.5px; font-weight: 700; color: var(--muted-2); white-space: nowrap; }
.rb.sel small { color: var(--blue-ink); }
.rb small em { font-style: normal; margin-left: 4px; padding: 1px 6px; border-radius: 999px; background: #FFFFFF; color: var(--blue-ink); font-size: 11px; }
/* rates */
.rates { display: grid; gap: 10px; align-content: center; }
.r-lab { font-size: 13px; font-weight: 700; color: var(--ink); }
.r-val { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
.r-seg { position: relative; display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 18px; background: rgba(255, 255, 255, 0.55); font-size: 13px; font-weight: 700; color: var(--muted-2); }
.r-seg > span { position: relative; z-index: 1; height: 32px; padding: 0 11px; display: inline-flex; align-items: center; gap: 4px; border-radius: 999px; transition: color 200ms; }
.r-seg > span.on { color: var(--ink); }
.r-seg .i { width: 14px; height: 14px; }
.r-ind { position: absolute; left: 0; top: 0; height: 32px; width: 0; border-radius: 999px; background: #FFFFFF; box-shadow: 0 1px 3px rgba(16, 32, 24, 0.1); }
/* groups */
.groups { display: grid; gap: 14px; align-content: center; perspective: 600px; }
.code { display: flex; gap: 6px; }
.code i { font-style: normal; width: 38px; height: 46px; display: grid; place-items: center; border-radius: 10px; background: #FFFFFF; color: var(--ink); font-size: 22px; font-weight: 800; box-shadow: 0 1px 3px rgba(16, 32, 24, 0.08); }
.act { display: grid; gap: 6px; font-size: 14px; font-weight: 600; }
.act li { display: flex; align-items: center; gap: 8px; }
.act .avatar { width: 26px; height: 26px; font-size: 12px; }
/* recurring */
.rec { display: grid; gap: 12px; align-content: center; }
.rec-head { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 16px; background: #FFFFFF; }
.rec-head > b { font-weight: 800; }
.rec-track { height: 8px; border-radius: 8px; background: rgba(255, 255, 255, 0.7); overflow: hidden; }
.rec-track i { display: block; height: 100%; width: 100%; border-radius: 8px; background: var(--green); transform: scaleX(0.5); transform-origin: 0 50%; }
.rec-ppl { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.rec-ppl li { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 6px 8px; padding: 8px; border-radius: 14px; background: rgba(255, 255, 255, 0.7); font-size: 14px; min-width: 0; }
.rec-ppl .tag { grid-column: 1 / -1; justify-self: start; }
.rec-ppl .avatar { width: 28px; height: 28px; font-size: 12px; }
.rec-ppl b { flex: 1; }
.tag[data-s="owner"] { background: var(--brand-soft); color: var(--brand); }
.tag[data-s="paid"] { background: var(--green-soft); color: var(--green-ink); }
.tag[data-s="reported"] { background: var(--yellow-soft); color: var(--yellow-ink); }
.tag[data-s="pending"] { background: var(--surface-alt); color: var(--muted-2); }
.also { margin-top: 16px; display: grid; border-top: 1px solid var(--line); }
.also li { display: flex; align-items: center; gap: 14px; padding: 16px 4px; border-bottom: 1px solid var(--line); font-weight: 600; }
.also li span { flex: 1; }
.also .i { width: 22px; height: 22px; color: var(--brand); }
.also time { color: var(--muted); font-size: 14px; font-weight: 700; white-space: nowrap; }
@media (min-width: 900px) {
  .news { grid-template-columns: repeat(5, 1fr); }
  .news-card { grid-column: span 2; }
  .news-card.wide { grid-column: span 3; }
  .news-card.wide { grid-template-rows: none; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
  .news-card.wide .nc-vis { margin: 12px 12px 12px 0; }
}

/* ---------- Features ---------- */
.tiles { display: grid; gap: 16px; }
.tile { border-radius: 28px; background: var(--canvas); padding: 12px 12px 24px; display: grid; gap: 6px; align-content: start; }
.tile h3 { padding: 12px 12px 0; font-size: 20px; line-height: 1.2; font-weight: 800; letter-spacing: -0.01em; }
.tile p { padding: 0 12px; color: var(--muted-2); font-size: 15.5px; max-width: 46ch; }
.t-vis { position: relative; height: 168px; border-radius: 20px; background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; overflow: hidden; padding: 16px; }
.fan { position: relative; width: 168px; height: 108px; }
.wcard { position: absolute; inset: 0; border-radius: 20px; padding: 12px; color: #FFFFFF; display: flex; flex-direction: column; justify-content: flex-end; box-shadow: 0 10px 24px -10px rgba(16, 32, 24, 0.4); }
.wcard small { font-size: 12px; color: rgba(255, 255, 255, 0.86); font-weight: 600; }
.wcard b { font-size: 19px; font-weight: 800; }
.wcard:nth-child(1) { transform: translateX(-150px) rotate(-4deg); }
.wcard:nth-child(3) { transform: translateX(150px) rotate(4deg); }
@media (max-width: 719px) { .wcard:nth-child(1) { transform: translateX(-92px) rotate(-4deg) scale(0.86); } .wcard:nth-child(3) { transform: translateX(92px) rotate(4deg) scale(0.86); } }
.seg3 { position: relative; display: flex; padding: 4px; border-radius: 999px; background: var(--surface-alt); font-size: 13.5px; font-weight: 700; color: var(--muted-2); }
.seg3 > span { position: relative; z-index: 1; height: 32px; padding: 0 12px; display: grid; place-items: center; border-radius: 999px; }
.seg-ind { position: absolute; left: 4px; top: 4px; height: 32px; width: 0; border-radius: 999px; background: #FBE1DD; }
.kind-amt { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 28px; font-weight: 800; letter-spacing: -0.02em; color: var(--expense-text); }
.kind-amt .i { width: 26px; height: 26px; }
.cloud { flex-direction: row; flex-wrap: wrap; align-content: center; gap: 6px; }
.cloud .chip { height: 32px; font-size: 13.5px; padding: 0 10px 0 8px; }
.chip { height: 36px; padding: 0 12px 0 9px; display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line-2); font-size: 14px; font-weight: 600; }
.chip .i { width: 17px; height: 17px; }
.chip.tagc { background: var(--purple-soft); border-color: transparent; color: var(--purple-ink); }
.methods { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 6px; border-radius: 18px; background: var(--canvas); font-size: 13.5px; font-weight: 700; }
.methods > span { position: relative; z-index: 1; height: 38px; padding: 0 10px; display: flex; align-items: center; gap: 6px; border-radius: 12px; transition: color 200ms; }
.methods > span.on { color: #FFFFFF; }
.methods .i { width: 17px; height: 17px; }
.m-ind { position: absolute; left: 6px; top: 6px; height: 38px; width: 0; border-radius: 12px; background: var(--brand); }
.habit { gap: 10px; }
.habit .spill { background: var(--orange-soft); color: var(--orange-ink); }
.habit .spill .i { color: var(--orange); }
.week { display: flex; align-items: flex-end; gap: 6px; height: 54px; }
.week i { width: 16px; height: calc(var(--h) * 54px); border-radius: 6px; background: var(--brand-soft); transform-origin: 50% 100%; }
.week .today { background: var(--brand); }
.week .future { background: var(--surface-alt); }
.lvl { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.lvl b { font-weight: 800; color: var(--yellow-ink); }
.lvl-bar { width: 110px; height: 8px; border-radius: 8px; background: var(--surface-alt); overflow: hidden; }
.lvl-bar i { display: block; height: 100%; width: 100%; background: var(--yellow); transform: scaleX(0.64); transform-origin: 0 50%; }
.sp { width: min(100%, 420px); display: grid; gap: 14px; }
.sp-seg { position: relative; }
.sp-seg > span { height: 32px; }
.sp-ind { position: absolute; left: 4px; top: 4px; height: 34px; width: 0; border-radius: 999px; background: var(--surface); box-shadow: 0 1px 3px rgba(16, 32, 24, 0.1); }
.sp-bars { display: grid; gap: 8px; }
.sp-bars > span { display: grid; grid-template-columns: 44px 1fr 84px; align-items: center; gap: 10px; font-size: 14px; }
.sp-bars em { font-style: normal; font-weight: 800; text-align: right; }
.sp-b { height: 12px; border-radius: 12px; width: 33.3%; }
.th-wrap { position: relative; width: min(100%, 360px); height: 120px; }
.th-card { position: absolute; inset: 0; border-radius: 20px; padding: 16px; display: grid; gap: 12px; align-content: start; }
.th-card.day { background: var(--canvas); color: var(--text); }
.th-card.night { background: #151D19; color: #E8EFEA; clip-path: circle(0% at 92% 16%); }
.th-top { display: flex; justify-content: space-between; font-size: 14px; }
.th-top span { color: var(--muted); }
.night .th-top span, .night small { color: #9AA69F; }
.th-tot { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.th-tot small { display: block; font-size: 12px; color: var(--muted); }
.th-tot b { font-size: 18px; font-weight: 800; }
.day .th-tot span:first-child b { color: var(--income-text); } .day .th-tot span:last-child b { color: var(--expense-text); }
.night .th-tot span:first-child b { color: #74D69B; } .night .th-tot span:last-child b { color: #FF9A8F; }
.th-sw { position: absolute; right: 10px; top: 8px; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); box-shadow: 0 1px 3px rgba(16, 32, 24, 0.12); color: var(--orange); }
.th-sw .i { grid-area: 1 / 1; width: 19px; height: 19px; }
.th-sw .moon { color: #8BBDF0; opacity: 0; }
.roll { height: 40px; overflow: hidden; }
.roll-in { display: flex; flex-direction: column; }
.roll-in b { height: 40px; display: grid; place-items: center; font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
.roll-in b + b { color: var(--blue-ink); }
[data-tile="lang"] .t-vis { flex-direction: row; gap: 20px; flex-wrap: wrap; }
@media (min-width: 720px) {
  .tiles { grid-template-columns: repeat(2, 1fr); }
  .tile.wide { grid-column: span 2; }
}
@media (min-width: 1040px) {
  .tiles { grid-template-columns: repeat(4, 1fr); }
  .tile.wide { grid-column: span 2; }
}

/* ---------- Start ---------- */
.start-wrap { max-width: 1240px; }
.start { border-radius: 40px; background: radial-gradient(110% 80% at 15% 0%, #155B41 0%, var(--hero) 50%, var(--hero-deep) 100%); color: #FFFFFF; padding: 56px 24px 32px; display: grid; gap: 40px; overflow: hidden; }
.start h2 { color: #FFFFFF; }
.start-copy { display: grid; gap: 20px; align-content: start; }

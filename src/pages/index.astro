<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { SplitText } from 'gsap/SplitText';

gsap.registerPlugin(ScrollTrigger, SplitText);

const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector(s) as T;
const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => Array.from(root.querySelectorAll(s)) as T[];
const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 });
const money = (v: number) => '$ ' + fmt.format(Math.round(v / 100) * 100);
const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
const EXPO = 'expo.out';

/* ---------- Fixed-size scenes scale down to their column ---------- */
for (const box of $$('[data-fit]')) {
  const inner = box.firstElementChild as HTMLElement;
  const w = Number(box.dataset.w);
  const h = Number(box.dataset.h);
  const max = Number(box.dataset.max ?? 1);
  box.style.maxWidth = `${w * max}px`;
  new ResizeObserver(() => {
    const k = Math.min(max, box.clientWidth / w);
    inner.style.transform = `scale(${k})`;
    box.style.height = `${h * k}px`;
  }).observe(box);
}

/* ---------- Nav: floating pill plus a marker that follows the current section ---------- */
const navWrap = $('#navWrap');
new IntersectionObserver(([e]) => navWrap.classList.toggle('floating', !e.isIntersecting)).observe($('.nav-sentinel'));
const navInd = $('#navInd');
const navLinks = $$<HTMLAnchorElement>('#navLinks a');
function markNav(link: HTMLAnchorElement | null) {
  navLinks.forEach((a) => a.classList.toggle('on', a === link));
  if (!link) { gsap.to(navInd, { opacity: 0, duration: 0.3 }); return; }
  gsap.to(navInd, { x: link.offsetLeft, width: link.offsetWidth, opacity: 1, duration: 0.5, ease: EXPO });
}
// The marker sits on the last section whose top has crossed 45% of the viewport, so fast jumps never strand it
const sections = navLinks.map((a) => [a, $(a.getAttribute('href')!)] as const);
let navCurrent: HTMLAnchorElement | null | undefined;
function syncNav() {
  const line = innerHeight * 0.45;
  let pick: HTMLAnchorElement | null = null;
  for (const [a, section] of sections) if (section.getBoundingClientRect().top < line) pick = a;
  if (pick !== navCurrent) { navCurrent = pick; markNav(pick); }
}
ScrollTrigger.create({ start: 0, end: 'max', onUpdate: syncNav, onRefresh: syncNav });

/* A demo timeline whose text is derived from its playhead, so seeking and looping always render the right numbers. */
type Track = (t: number) => void;
function tracked(tl: gsap.core.Timeline) {
  const tracks: Track[] = [];
  const render = () => { const t = tl.time(); for (const f of tracks) f(t); };
  tl.eventCallback('onUpdate', render);
  tl.eventCallback('onRepeat', render);
  return { tracks, render };
}
const frames = (el: HTMLElement, list: [number, string][]): Track => (t) => {
  let txt = list[0][1];
  for (const [at, v] of list) if (t >= at) txt = v;
  if (el.textContent !== txt) el.textContent = txt;
};
const count = (el: HTMLElement, steps: [number, number][], f = money): Track => (t) => {
  // steps: [[time, value]...]; eases out between consecutive points
  let v = steps[0][1];
  for (let i = 1; i < steps.length; i++) {
    const [ta, va] = steps[i - 1];
    const [tb, vb] = steps[i];
    if (t >= tb) v = vb;
    else if (t > ta) { const p = clamp01((t - ta) / (tb - ta)); v = va + (vb - va) * (1 - Math.pow(1 - p, 3)); break; }
  }
  const txt = f(v);
  if (el.textContent !== txt) el.textContent = txt;
};

/* Pause button bound to a demo: user pause wins over visibility */
function demoControl(tl: gsap.core.Timeline, btn: HTMLButtonElement, trigger: Element) {
  let userPaused = false;
  let visible = false;
  const sync = () => { if (!userPaused && visible) tl.play(); else tl.pause(); };
  btn.addEventListener('click', () => {
    userPaused = !userPaused;
    btn.setAttribute('aria-pressed', String(userPaused));
    btn.querySelector('use')!.setAttribute('href', userPaused ? '#i-play' : '#i-pause');
    btn.querySelector('span')!.textContent = userPaused ? 'Seguir' : 'Pausar';
    sync();
  });
  ScrollTrigger.create({ trigger, start: 'top 85%', end: 'bottom 15%', onToggle: (self) => { visible = self.isActive; sync(); } });
  return { resume: () => { visible = true; sync(); }, isPaused: () => userPaused };
}

const mm = gsap.matchMedia();

/* =====================================================================
   How it works: one bill through four steps
   ===================================================================== */
function buildHow() {
  const tl = gsap.timeline({ paused: true, repeat: -1, defaults: { ease: EXPO } });
  const { tracks, render } = tracked(tl);
  const key = (k: string) => $(`#sKp [data-k="${k}"]`);
  const L1 = ['#sAmt', '#sChips', '#sKp', '#sSave'];
  const STEP_AT = [0, 4.6, 8, 11.2];
  const END = 15.6;

  // start state
  tl.set(['#sToken', '#sMonth', '#sSplit', '#sDone', '#sFlyV', '#sFlyS', '#sFlyT'], { autoAlpha: 0, x: 0, y: 0, scale: 1 }, 0)
    .set(L1, { autoAlpha: 1, y: 0, scale: 1 }, 0)
    .set(['#sTagV', '#sTagS', '#sTagT'], { autoAlpha: 0, scale: 0.8 }, 0)
    .set(['#sArrS', '#sArrT'], { strokeDashoffset: 1 }, 0)
    .set('#sOwed', { autoAlpha: 0, y: 0 }, 0)
    .set('#sBarFood', { width: '31.8%' }, 0)
    .set('#sFoodRow', { backgroundColor: 'rgba(252,232,214,0)' }, 0)
    .addLabel('s1', 0)
    .from(L1, { autoAlpha: 0, y: 16, stagger: 0.06, duration: 0.6 }, 0.05);

  // step 1: type 48.300
  const digits: [string, number][] = [['4', 0.7], ['8', 1.05], ['3', 1.4], ['0', 1.7], ['0', 2.0]];
  for (const [k, at] of digits) tl.to(key(k), { backgroundColor: '#DCEBE3', scale: 0.92, duration: 0.09, yoyo: true, repeat: 1, ease: 'power1.out' }, at);
  tracks.push(frames($('#sTyped'), [[0, '$ 0'], [0.75, '$ 4'], [1.1, '$ 48'], [1.45, '$ 483'], [1.75, '$ 4.830'], [2.05, '$ 48.300']]));
  const toggleAt = (el: Element, cls: string, at: number): Track => (t) => el.classList.toggle(cls, t >= at);
  tracks.push(toggleAt($('#sChipFood'), 'sel', 2.4));
  tl.fromTo('#sChipFood', { scale: 0.9 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' }, 2.4)
    .to('#sSave', { scale: 0.95, duration: 0.1, yoyo: true, repeat: 1, ease: 'power1.out' }, 2.85)
    .to(['#sChips', '#sKp', '#sSave'], { autoAlpha: 0, y: 24, filter: 'blur(6px)', stagger: 0.04, duration: 0.5, ease: 'power2.in' }, 3.05)
    .to('#sAmt', { autoAlpha: 0, scale: 0.7, duration: 0.4, ease: 'power2.in' }, 3.05)
    .fromTo('#sToken', { autoAlpha: 0, scale: 0.85, y: 6 }, { autoAlpha: 1, scale: 1, y: 0, duration: 0.7 }, 3.3)
    .set(['#sChips', '#sKp', '#sSave'], { filter: 'none' }, 4.5);

  // step 2: the bill drops into its category
  tl.addLabel('s2', STEP_AT[1])
    .fromTo('#sMonth', { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.7 }, 4.6)
    .to('#sToken', { y: 160, scale: 0.42, autoAlpha: 0, duration: 0.7, ease: 'power3.in' }, 5.3)
    .to('#sFoodRow', { backgroundColor: 'rgba(252,232,214,1)', duration: 0.25, yoyo: true, repeat: 1, ease: 'power1.out' }, 5.95)
    .to('#sBarFood', { width: '40.2%', duration: 0.9 }, 6.0);
  tracks.push(count($('#sFood'), [[0, 182400], [6.0, 182400], [6.9, 230700]]));
  tracks.push(count($('#sTotal'), [[0, 525800], [6.0, 525800], [6.9, 574100]]));

  // step 3: split three ways
  tl.addLabel('s3', STEP_AT[2])
    .to('#sMonth', { autoAlpha: 0, y: -16, duration: 0.4, ease: 'power2.in' }, 8.0)
    .fromTo('#sToken', { autoAlpha: 0, y: -14, scale: 1 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.6 }, 8.3)
    .fromTo('#sSplit', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.5 }, 8.4);
  const flyFrom = { x: -130, scale: 0.6 };
  [['#sFlyV', -134], ['#sFlyS', -190], ['#sFlyT', -246]].forEach(([sel, dy], i) => {
    tl.fromTo(sel as string, { autoAlpha: 0, x: flyFrom.x, y: dy as number, scale: flyFrom.scale }, { autoAlpha: 1, x: 0, y: 0, scale: 1, duration: 0.8, ease: 'power3.out' }, 8.9 + i * 0.16);
  });
  tl.to('#sTagV', { autoAlpha: 1, scale: 1, duration: 0.4, ease: 'back.out(2)' }, 9.6)
    .fromTo('#sOwed', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.6 }, 9.8);
  tracks.push(count($('#sOwedVal'), [[0, 32200], [11.6, 32200], [12.2, 16100], [12.7, 16100], [13.3, 0]]));

  // step 4: settle up
  tl.addLabel('s4', STEP_AT[3])
    .to('#sArrS', { strokeDashoffset: 0, duration: 0.7, ease: 'power2.inOut' }, 11.4)
    .to('#sFlyS', { autoAlpha: 0, x: 16, duration: 0.3, ease: 'power2.in' }, 11.8)
    .to('#sTagS', { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'back.out(2)' }, 11.9)
    .to('#sArrT', { strokeDashoffset: 0, duration: 0.7, ease: 'power2.inOut' }, 12.5)
    .to('#sFlyT', { autoAlpha: 0, x: 16, duration: 0.3, ease: 'power2.in' }, 12.9)
    .to('#sTagT', { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'back.out(2)' }, 13.0)
    .to('#sOwed', { autoAlpha: 0, y: -10, duration: 0.35, ease: 'power2.in' }, 13.6)
    .fromTo('#sDone', { autoAlpha: 0, scale: 0.85 }, { autoAlpha: 1, scale: 1, duration: 0.6, ease: 'back.out(2.2)' }, 13.8)
    .to({}, { duration: END - 14.4 }, 14.4);

  // step buttons and their progress bars
  const btns = $$<HTMLButtonElement>('.hstep');
  const bars = btns.map((b) => $('.hbar i', b));
  const live = $('#howLive');
  const LIVE = ['Paso 1: anotás una cena de $ 48.300.', 'Paso 2: la cena suma a Comida y el mes se actualiza.', 'Paso 3: se divide en tres partes de $ 16.100.', 'Paso 4: Sofi y Tomi te pagan y queda todo saldado.'];
  let current = -1;
  tracks.push((t) => {
    let idx = 0;
    for (let i = 0; i < STEP_AT.length; i++) if (t >= STEP_AT[i]) idx = i;
    const end = STEP_AT[idx + 1] ?? END;
    if (idx !== current) {
      current = idx;
      btns.forEach((b, i) => { b.classList.toggle('is-on', i === idx); b.setAttribute('aria-selected', String(i === idx)); });
      live.textContent = LIVE[idx];
    }
    bars.forEach((bar, i) => gsap.set(bar, { scaleX: i === idx ? clamp01((t - STEP_AT[idx]) / (end - STEP_AT[idx])) : 0 }));
  });

  return { tl, render, btns, STEP_AT };
}

/* =====================================================================
   Start: open the app, say your name, log the first coffee
   ===================================================================== */
function buildStart() {
  const tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 1.2, defaults: { ease: EXPO } });
  const { tracks, render } = tracked(tl);
  tl.set('#obIcon', { autoAlpha: 1, scale: 1 }, 0)
    .set('#obA', { autoAlpha: 0, scale: 1.04 }, 0)
    .set('#obB', { autoAlpha: 0 }, 0)
    .set(['#obRow', '#obToast'], { autoAlpha: 0, y: -20 }, 0)
    .fromTo('#obIcon span', { scale: 0.4, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 0.7, ease: 'back.out(1.8)' }, 0.15)
    .to('#obIcon span', { scale: 7, duration: 0.7, ease: 'power3.in' }, 1.15)
    .to('#obIcon', { autoAlpha: 0, duration: 0.35 }, 1.5)
    .to('#obA', { autoAlpha: 1, scale: 1, duration: 0.6 }, 1.45)
    .fromTo('#obArs', { scale: 0.9 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' }, 3.0)
    .to('#obGo', { scale: 0.95, duration: 0.1, yoyo: true, repeat: 1 }, 3.55)
    .to('#obA', { autoAlpha: 0, x: -40, duration: 0.45, ease: 'power2.in' }, 3.85)
    .fromTo('#obB', { autoAlpha: 0, x: 40 }, { autoAlpha: 1, x: 0, duration: 0.6 }, 4.15)
    .set('#obA', { x: 0 }, 4.8)
    .fromTo('#obCafe', { scale: 0.9 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' }, 5.8)
    .to('#obSave', { scale: 0.95, duration: 0.1, yoyo: true, repeat: 1 }, 6.2)
    .to('#obRow', { autoAlpha: 1, y: 0, duration: 0.7, ease: 'back.out(1.6)' }, 6.45)
    .fromTo('#obStreak', { scale: 0.8 }, { scale: 1, duration: 0.6, ease: 'back.out(3)' }, 7.0)
    .to('#obToast', { autoAlpha: 1, y: 0, duration: 0.6, ease: 'back.out(2)' }, 7.3)
    .to({}, { duration: 2 }, 7.9);
  tracks.push((t) => $('#obArs').classList.toggle('sel', t >= 3.0));
  tracks.push((t) => $('#obCafe').classList.toggle('sel', t >= 5.8));
  tracks.push((t) => $('#obStreak').classList.toggle('lit', t >= 7.0));
  tracks.push(frames($('#obName'), [[0, ''], [1.9, 'V'], [2.1, 'Va'], [2.3, 'Val'], [2.5, 'Vale']]));
  tracks.push(frames($('#obAmt'), [[0, '$ 0'], [4.7, '$ 4'], [4.95, '$ 45'], [5.2, '$ 450'], [5.45, '$ 4.500']]));
  tracks.push(frames($('#obStreakN'), [[0, '0'], [7.0, '1']]));
  const steps = $$('.st-steps li');
  tracks.push((t) => {
    const idx = t < 1.45 ? 0 : t < 4.15 ? 1 : 2;
    steps.forEach((li, i) => li.classList.toggle('is-on', i === idx));
  });
  return { tl, render };
}

const how = buildHow();
const start = buildStart();

/* ---------- Full motion ---------- */
mm.add('(prefers-reduced-motion: no-preference)', () => {
  /* Headings rise line by line out of a mask */
  for (const h of $$('h2.split')) {
    SplitText.create(h, {
      type: 'lines', mask: 'lines', autoSplit: true,
      onSplit: (self) => gsap.from(self.lines, { yPercent: 105, duration: 1.1, ease: EXPO, stagger: 0.09, scrollTrigger: { trigger: h, start: 'top 88%', once: true } }),
    });
  }

  /* ----- Hero: lines draw, nodes land, then one coffee ripples through ----- */
  const nodes = $$('.node');
  const intro = gsap.timeline({ defaults: { ease: EXPO } });
  SplitText.create('.hero-title', {
    type: 'lines', mask: 'lines', autoSplit: true,
    onSplit: (self) => gsap.from(self.lines, { yPercent: 105, duration: 1.2, stagger: 0.1, ease: EXPO }),
  });
  const amountEl = $('#cAmount');
  const walletEl = $('#cWallet');
  const streakEl = $('#cStreak');
  const spark = $<SVGCircleElement>('#spark');
  const travel = (path: SVGPathElement, dur: number) => {
    const len = path.getTotalLength();
    const o = { p: 0 };
    return gsap.to(o, { p: 1, duration: dur, ease: 'power1.inOut', onUpdate: () => { const pt = path.getPointAtLength(o.p * len); spark.setAttribute('cx', String(pt.x)); spark.setAttribute('cy', String(pt.y)); } });
  };
  const pulse = (el: Element) => gsap.fromTo(el, { scale: 1.08 }, { scale: 1, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
  intro
    .from(['.lead', '.hero-actions', '.soon'], { autoAlpha: 0, y: 18, stagger: 0.08, duration: 1 }, 0.3)
    .from(nodes, { autoAlpha: 0, scale: 0.7, filter: 'blur(10px)', stagger: 0.07, duration: 0.9 }, 0.35)
    .from('.ln', { strokeDashoffset: 1, stagger: 0.08, duration: 1.1, ease: 'power2.inOut' }, 0.6)
    .add(() => { amountEl.textContent = '$ 0'; walletEl.textContent = '$ 38.200'; streakEl.textContent = '12'; }, 0)
    .add(() => { amountEl.textContent = '$ 4'; }, 1.5)
    .add(() => { amountEl.textContent = '$ 45'; }, 1.7)
    .add(() => { amountEl.textContent = '$ 450'; }, 1.9)
    .add(() => { amountEl.textContent = '$ 4.500'; }, 2.1)
    .to(spark, { opacity: 1, duration: 0.2 }, 2.35)
    .add(travel($('#lnA'), 0.8), 2.35)
    .add(() => { pulse('.n-chip'); }, 3.15)
    .add(travel($('#lnB'), 0.7), 3.15)
    .add(() => { pulse('.n-row'); }, 3.85)
    .add(travel($('#lnC'), 0.8), 3.85)
    .add(() => {
      pulse('.n-wallet');
      const w = { v: 38200 };
      gsap.to(w, { v: 33700, duration: 0.8, ease: 'power2.out', onUpdate: () => { walletEl.textContent = money(w.v); } });
      streakEl.textContent = '13';
      pulse('.n-streak');
    }, 4.65)
    .to(spark, { opacity: 0, duration: 0.4 }, 4.7);

  /* Pointer parallax, by node depth */
  const hero = $('.hero');
  if (window.matchMedia('(pointer: fine)').matches) {
    const movers = nodes.map((n) => ({ d: Number(n.dataset.d), x: gsap.quickTo(n, 'x', { duration: 0.9, ease: 'power3' }), y: gsap.quickTo(n, 'y', { duration: 0.9, ease: 'power3' }) }));
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      for (const m of movers) { m.x(px * 18 * m.d); m.y(py * 14 * m.d); }
    });
    hero.addEventListener('pointerleave', () => { for (const m of movers) { m.x(0); m.y(0); } });
  }
  /* Scrolling away pulls the constellation apart */
  gsap.to(nodes, { yPercent: (i) => -30 * Number(nodes[i].dataset.d), ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });

  /* ----- Why: the rule draws, then each row acts out its word ----- */
  for (const row of $$('.why-row')) {
    const tl = gsap.timeline({ defaults: { ease: EXPO }, scrollTrigger: { trigger: row, start: 'top 80%', once: true } });
    tl.from($('.rule', row), { scaleX: 0, duration: 1.2 })
      .from($('.why-word', row), { yPercent: 40, autoAlpha: 0, duration: 0.9 }, 0.1)
      .from($('p', row), { autoAlpha: 0, y: 14, duration: 0.8 }, 0.25);
    const fx = $('.why-fx', row);
    if (fx.classList.contains('fx-taps')) {
      const pills = $$('span', fx);
      tl.from(fx.children, { autoAlpha: 0, x: -10, stagger: 0.05, duration: 0.5 }, 0.3);
      pills.forEach((p, i) => tl.add(() => p.classList.add('lit'), 0.8 + i * 0.35).fromTo(p, { scale: 0.92 }, { scale: 1, duration: 0.4, ease: 'back.out(3)' }, 0.8 + i * 0.35));
      tl.from($('.ok', fx), { scale: 0, rotate: -90, duration: 0.6, ease: 'back.out(2.5)' }, 1.9);
    } else if (fx.classList.contains('fx-no')) {
      tl.from(fx.children, { autoAlpha: 0, y: 10, stagger: 0.08, duration: 0.5 }, 0.3)
        .from($$('.strike i', fx), { scaleX: 0, stagger: 0.3, duration: 0.5, ease: 'power2.inOut' }, 1)
        .to($$('.strike span', fx), { opacity: 0.5, stagger: 0.3, duration: 0.3 }, 1.3)
        .fromTo($('.lock', fx), { boxShadow: '0 0 0 0 rgba(14,74,52,0.35)' }, { boxShadow: '0 0 0 14px rgba(14,74,52,0)', duration: 1.1, ease: 'power2.out' }, 1.6);
    } else {
      tl.from($$('.avatar', fx), { x: (i) => i * 34, autoAlpha: 0, duration: 0.9, stagger: 0.06 }, 0.3)
        .from($('.fx-pill', fx), { autoAlpha: 0, scale: 0.8, duration: 0.6, ease: 'back.out(2)' }, 1);
    }
  }

  /* ----- How it works: autoplay while visible, click a step to jump ----- */
  const howCtl = demoControl(how.tl, $('#howPause'), '.how-stage');
  how.btns.forEach((b, i) => b.addEventListener('click', () => { how.tl.seek(how.STEP_AT[i], false); how.render(); if (!howCtl.isPaused()) howCtl.resume(); }));
  gsap.from('.how-stage', { y: 60, autoAlpha: 0, duration: 1.1, ease: EXPO, scrollTrigger: { trigger: '.how-stage', start: 'top 90%', once: true } });
  gsap.from('.hstep .hn, .hstep .ht', { x: -20, autoAlpha: 0, stagger: 0.07, duration: 0.8, ease: EXPO, scrollTrigger: { trigger: '.how-steps', start: 'top 85%', once: true } });
  how.render();

  /* ----- What's new: cards wipe in, each visual plays its change once ----- */
  for (const card of $$('.news-card')) {
    const tl = gsap.timeline({ defaults: { ease: EXPO }, scrollTrigger: { trigger: card, start: 'top 82%', once: true } });
    tl.from(card, { clipPath: 'inset(12% 6% 12% 6% round 28px)', autoAlpha: 0, y: 30, duration: 1.1 });
    newsMotion(card.dataset.news!, card, tl);
  }
  gsap.from('.also li', { autoAlpha: 0, y: 12, stagger: 0.08, duration: 0.7, ease: EXPO, scrollTrigger: { trigger: '.also', start: 'top 88%', once: true } });

  /* ----- Features: each tile plays once on view, again on hover ----- */
  for (const tile of $$('.tile')) {
    const tl = tileMotion(tile.dataset.tile!, tile);
    gsap.from(tile, { autoAlpha: 0, y: 40, duration: 1, ease: EXPO, scrollTrigger: { trigger: tile, start: 'top 88%', once: true, onEnter: () => { gsap.delayedCall(0.35, () => tl.play(0)); } } });
    tile.addEventListener('mouseenter', () => { if (!tl.isActive()) tl.play(0); });
  }

  /* ----- Start ----- */
  demoControl(start.tl, $('#stPause'), '.start-demo');
  start.render();
  gsap.from('.st-steps li', { autoAlpha: 0, x: -16, stagger: 0.08, duration: 0.8, ease: EXPO, scrollTrigger: { trigger: '.st-steps', start: 'top 85%', once: true } });

  /* ----- Compare: the Loneto column rises, rows settle in ----- */
  const cmp = gsap.timeline({ defaults: { ease: EXPO }, scrollTrigger: { trigger: '.cmp-box', start: 'top 78%', once: true } });
  cmp.from('.cmp-col', { scaleY: 0, duration: 1.2 })
    .from('.cmp thead th', { autoAlpha: 0, y: 10, stagger: 0.06, duration: 0.6 }, 0.1)
    .from('.cmp tbody tr', { autoAlpha: 0, y: 16, stagger: 0.07, duration: 0.7 }, 0.2)
    .from('.cmp td.me .i', { scale: 0, rotate: -60, stagger: 0.07, duration: 0.6, ease: 'back.out(2.4)' }, 0.5);

  /* ----- Close ----- */
  gsap.from('.close-moni', { y: 40, rotate: -12, scale: 0.8, autoAlpha: 0, duration: 1.2, ease: 'elastic.out(1, 0.6)', scrollTrigger: { trigger: '.close', start: 'top 80%', once: true } });

  return () => { how.tl.pause(); start.tl.pause(); };
});

/* ---------- Reduced motion: no autoplay; steps show their settled frame ---------- */
mm.add('(prefers-reduced-motion: reduce)', () => {
  const settle = (i: number) => (i < 3 ? how.STEP_AT[i + 1] - 0.05 : 15.5);
  how.tl.pause();
  how.tl.seek(settle(0), false); how.render();
  const onClick = (i: number) => () => { how.tl.seek(settle(i), false); how.render(); };
  const handlers = how.btns.map((b, i) => { const h = onClick(i); b.addEventListener('click', h); return [b, h] as const; });
  $('#howPause').hidden = true;
  $('#stPause').hidden = true;
  start.tl.pause(); start.tl.seek(9.5, false); start.render();
  for (const tile of $$('.tile')) tileMotion(tile.dataset.tile!, tile).progress(1);
  for (const card of $$('.news-card')) { const tl = gsap.timeline({ paused: true }); newsMotion(card.dataset.news!, card, tl); tl.progress(1); }
  return () => { handlers.forEach(([b, h]) => b.removeEventListener('click', h)); $('#howPause').hidden = false; $('#stPause').hidden = false; };
});

/* ---------- Per-card motion for What's new ---------- */
function newsMotion(kind: string, card: HTMLElement, tl: gsap.core.Timeline) {
  if (kind === 'reports') {
    const bars = $$('.rb i', card);
    tl.from(bars, { scaleY: 0, stagger: 0.08, duration: 0.9 }, 0.4)
      .from($$('.rb small', card), { autoAlpha: 0, stagger: 0.08, duration: 0.5 }, 0.5)
      .to($('.rep-track', card), { x: () => -($('.rb', card).offsetWidth + 12), duration: 1, ease: 'power3.inOut' }, 1.6);
    const pct = $('.rep-pct', card);
    const o = { v: 0 };
    tl.to(o, { v: 12, duration: 0.9, ease: 'power2.out', onUpdate: () => { pct.textContent = String(Math.round(o.v)); } }, 0.9);
  } else if (kind === 'rates') {
    const ind = $('.r-ind', card);
    const opts = $$('.r-seg > span', card);
    const num = $('.r-num', card);
    const vals = [1385, 1432, 1445, 1400];
    const place = (i: number) => ({ x: () => opts[i].offsetLeft, y: () => opts[i].offsetTop, width: () => opts[i].offsetWidth });
    tl.set(ind, { ...place(0) }, 0.3).add(() => mark(0), 0.3);
    function mark(i: number) { opts.forEach((s, j) => s.classList.toggle('on', j === i)); }
    vals.forEach((v, i) => {
      if (!i) return;
      const at = 0.9 + i * 0.9;
      tl.to(ind, { ...place(i), duration: 0.55, ease: 'power3.inOut' }, at)
        .add(() => mark(i), at + 0.2)
        .fromTo(num, { yPercent: 0 }, { yPercent: -40, autoAlpha: 0, duration: 0.18, ease: 'power2.in' }, at)
        .add(() => { num.textContent = money(v); }, at + 0.18)
        .fromTo(num, { yPercent: 40, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: 0.4 }, at + 0.18);
    });
  } else if (kind === 'groups') {
    tl.from($$('.code i', card), { rotateX: -90, autoAlpha: 0, stagger: 0.07, duration: 0.7, transformOrigin: '50% 50% -20px' }, 0.4)
      .from($$('.act li', card), { x: -24, autoAlpha: 0, stagger: 0.14, duration: 0.7 }, 1);
  } else if (kind === 'recurring') {
    const juli = $('#recJuli');
    const nico = $('#recNico');
    tl.from($$('.rec-ppl li', card), { autoAlpha: 0, y: 12, stagger: 0.07, duration: 0.6 }, 0.4)
      .add(() => { juli.dataset.s = 'paid'; juli.textContent = 'Pagado'; }, 1.6)
      .fromTo(juli, { scale: 0.85 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' }, 1.6)
      .to($('.rec-track i', card), { scaleX: 0.75, duration: 0.8 }, 1.6)
      .add(() => { nico.dataset.s = 'reported'; nico.textContent = 'Informó que pagó'; }, 2.4)
      .fromTo(nico, { scale: 0.85 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' }, 2.4);
  }
}

/* ---------- Per-tile motion for Features (paused timelines) ---------- */
function tileMotion(kind: string, tile: HTMLElement) {
  const tl = gsap.timeline({ paused: true, defaults: { ease: EXPO } });
  if (kind === 'wallets') {
    const cards = $$('.wcard', tile);
    tl.from(cards[0], { x: 0, rotate: 0, duration: 1 }, 0).from(cards[2], { x: 0, rotate: 0, duration: 1 }, 0).from(cards[1], { scale: 0.9, duration: 0.8 }, 0);
  } else if (kind === 'kinds') {
    const ind = $('.seg-ind', tile);
    const opts = $$('.seg3 > span', tile);
    const amt = $('.kind-amt b', tile);
    const icon = $('.kind-amt use', tile);
    const amtBox = $('.kind-amt', tile);
    const states = [
      { bg: '#FBE1DD', color: '#B8433A', txt: '−$ 4.500', ico: '#i-arrow-down' },
      { bg: '#DDF3E4', color: '#1F7A44', txt: '+$ 1.250.000', ico: '#i-arrow-up' },
      { bg: '#DCEAF7', color: '#1F5F9A', txt: '$ 50.000', ico: '#i-swap-horizontal' },
    ];
    const go = (i: number, at: number) => {
      const s = opts[i];
      tl.to(ind, { x: () => s.offsetLeft - 4, width: () => s.offsetWidth, backgroundColor: states[i].bg, duration: 0.5, ease: 'power3.inOut' }, at)
        .to(amtBox, { yPercent: -30, autoAlpha: 0, duration: 0.15, ease: 'power2.in' }, at)
        .add(() => { amt.textContent = states[i].txt; icon.setAttribute('href', states[i].ico); amtBox.style.color = states[i].color; }, at + 0.15)
        .fromTo(amtBox, { yPercent: 30, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, duration: 0.4 }, at + 0.15);
    };
    tl.set(ind, { x: 0, width: () => opts[0].offsetWidth, backgroundColor: states[0].bg }, 0);
    go(0, 0); go(1, 1.1); go(2, 2.2); go(0, 3.3);
  } else if (kind === 'cats') {
    tl.from($$('.chip', tile), { scale: 0, autoAlpha: 0, stagger: { each: 0.07, from: 'random' }, duration: 0.6, ease: 'back.out(2.4)' }, 0);
  } else if (kind === 'methods') {
    const ind = $('.m-ind', tile);
    const opts = $$('.methods > span', tile);
    const at = (i: number) => ({ x: () => opts[i].offsetLeft - 6, y: () => opts[i].offsetTop - 6, width: () => opts[i].offsetWidth });
    const mark = (i: number) => opts.forEach((s, j) => s.classList.toggle('on', j === i));
    tl.set(ind, { ...at(0) }, 0).add(() => mark(0), 0);
    [2, 3, 1, 0].forEach((i, n) => {
      tl.to(ind, { ...at(i), duration: 0.5, ease: 'power3.inOut' }, 0.7 + n * 0.75).add(() => mark(i), 0.85 + n * 0.75);
    });
  } else if (kind === 'habit') {
    tl.from($$('.week i', tile), { scaleY: 0, stagger: 0.06, duration: 0.7 }, 0)
      .from($('.spill', tile), { scale: 0.7, autoAlpha: 0, duration: 0.6, ease: 'back.out(2.4)' }, 0.1)
      .from($('.lvl-bar i', tile), { scaleX: 0, duration: 1 }, 0.4);
  } else if (kind === 'split') {
    const ind = $('.sp-ind', tile);
    const opts = $$('.sp-seg > span', tile);
    const bars = $$('.sp-b', tile);
    const ems = $$('.sp-bars em', tile);
    const modes = [
      { w: [33.3, 33.3, 33.3], v: [16100, 16100, 16100] },
      { w: [50, 25, 25], v: [24150, 12075, 12075] },
      { w: [40, 30, 30], v: [19320, 14490, 14490] },
      { w: [41.4, 37.3, 20.7], v: [20000, 18300, 10000] },
    ];
    const vals = [...modes[0].v];
    const write = () => ems.forEach((e, i) => { e.textContent = '$ ' + fmt.format(Math.round(vals[i] / 5) * 5); });
    const go = (m: number, at: number) => {
      tl.to(ind, { x: () => opts[m].offsetLeft - 4, width: () => opts[m].offsetWidth, duration: 0.5, ease: 'power3.inOut' }, at);
      bars.forEach((b, i) => tl.to(b, { width: modes[m].w[i] + '%', duration: 0.7, ease: 'power3.inOut' }, at));
      tl.to(vals, { 0: modes[m].v[0], 1: modes[m].v[1], 2: modes[m].v[2], duration: 0.7, ease: 'power3.inOut', onUpdate: write }, at);
    };
    tl.set(ind, { x: 0, width: () => opts[0].offsetWidth }, 0);
    bars.forEach((b) => tl.set(b, { width: '33.3%' }, 0));
    tl.add(() => { vals.splice(0, 3, ...modes[0].v); write(); }, 0);
    tl.from(bars, { scaleX: 0, transformOrigin: '0 50%', stagger: 0.08, duration: 0.7 }, 0);
    go(1, 1); go(2, 2.1); go(3, 3.2); go(0, 4.3);
  } else if (kind === 'theme') {
    tl.set($('.night', tile), { clipPath: 'circle(0% at 92% 16%)' }, 0)
      .set($('.sun', tile), { autoAlpha: 1, rotate: 0 }, 0)
      .set($('.moon', tile), { autoAlpha: 0, rotate: -90 }, 0)
      .to($('.night', tile), { clipPath: 'circle(150% at 92% 16%)', duration: 1.2, ease: 'power3.inOut' }, 0.6)
      .to($('.sun', tile), { autoAlpha: 0, rotate: 90, duration: 0.4 }, 0.6)
      .to($('.moon', tile), { autoAlpha: 1, rotate: 0, duration: 0.5 }, 0.8)
      .to($('.night', tile), { clipPath: 'circle(0% at 92% 16%)', duration: 1, ease: 'power3.inOut' }, 2.8)
      .to($('.moon', tile), { autoAlpha: 0, rotate: -90, duration: 0.4 }, 2.8)
      .to($('.sun', tile), { autoAlpha: 1, rotate: 0, duration: 0.5 }, 3);
  } else if (kind === 'lang') {
    const rolls = $$('.roll-in', tile);
    tl.set(rolls, { yPercent: 0 }, 0)
      .to(rolls, { yPercent: -50, stagger: 0.15, duration: 0.7, ease: 'power3.inOut' }, 0.6)
      .to(rolls, { yPercent: 0, stagger: 0.15, duration: 0.7, ease: 'power3.inOut' }, 2.4);
  }
  return tl;
}

document.fonts?.ready.then(() => ScrollTrigger.refresh());
</script>
</Home>

  .cmp-col, .cmp colgroup { display: none; }
  .cmp, .cmp tbody { display: block; }
  .cmp thead { display: none; }
  .cmp tbody tr { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 18px 0; }
  .cmp tbody th { grid-column: 1 / -1; width: auto; padding: 0; font-size: 18px; }
  .cmp td { padding: 0; font-size: 15px; }
  .cmp td::before { content: attr(data-c); display: block; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }

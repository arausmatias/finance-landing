---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PostList from '../../components/PostList.astro';
import { sortPosts, SITE, ORGANIZATION, absoluteUrl } from '../../site';

const posts = sortPosts(await getCollection('blog'));
const title = `${SITE.blogName}: el blog de ${SITE.name}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.blogName,
    description: SITE.blogDescription,
    url: absoluteUrl('blog/'),
    inLanguage: SITE.locale,
    publisher: ORGANIZATION,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: absoluteUrl(`blog/${p.id}/`),
      datePublished: p.data.pubDate.toISOString().slice(0, 10),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: absoluteUrl() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: absoluteUrl('blog/') },
    ],
  },
];
---
<Base title={title} description={SITE.blogDescription} path="blog/" jsonLd={jsonLd}>
  <SiteNav current="blog" />
  <main>
    <section class="page-hero" aria-labelledby="h-blog">
      <p class="page-kicker"><svg class="i" aria-hidden="true"><use href="#i-file-document-outline"/></svg>Blog</p>
      <h1 id="h-blog" class="page-title">{SITE.blogName}</h1>
      <p class="lead">{SITE.blogDescription}</p>
    </section>
    <div class="wrap blog-main">
      <PostList posts={posts} />
    </div>
  </main>
  <SiteFooter />
<script>
import { gsap, SplitText, $$, EXPO } from '../../scripts/home-motion';

/* Same entrance as the changelog: the title rises out of its mask, then the cards deal in */
gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
  SplitText.create('.page-title', {
    type: 'lines', mask: 'lines', autoSplit: true,
    onSplit: (self) => gsap.from(self.lines, { yPercent: 105, duration: 1.2, stagger: 0.1, ease: EXPO }),
  });
  gsap.from(['.page-kicker', '.page-hero .lead'], { autoAlpha: 0, y: 16, stagger: 0.08, duration: 1, ease: EXPO, delay: 0.2 });
  gsap.from($$('.post-item'), { autoAlpha: 0, y: 40, stagger: 0.08, duration: 1, ease: EXPO, delay: 0.35 });
});
</script>
</Base>

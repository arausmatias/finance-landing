---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PostList from '../../components/PostList.astro';
import { sortPosts, SITE, ORGANIZATION, absoluteUrl } from '../../site';

const posts = sortPosts(await getCollection('blog'));
const title = `${SITE.blogName}: el blog de ${SITE.name}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: SITE.blogName,
    description: SITE.blogDescription,
    url: absoluteUrl('blog/'),
    inLanguage: SITE.locale,
    publisher: ORGANIZATION,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: absoluteUrl(`blog/${p.id}/`),
      datePublished: p.data.pubDate.toISOString().slice(0, 10),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: absoluteUrl() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: absoluteUrl('blog/') },
    ],
  },
];
---
<Base title={title} description={SITE.blogDescription} path="blog/" jsonLd={jsonLd}>
  <BlogHeader />
  <main class="wrap blog-main">
    <header class="blog-head">
      <h1>{SITE.blogName}</h1>
      <p>{SITE.blogDescription}</p>
    </header>
    <PostList posts={posts} />
  </main>
  <SiteFooter />
</Base>

---
import Sprite from '../components/Sprite.astro';
import SeoHead from '../components/SeoHead.astro';
import { SITE } from '../site';

/**
 * Shell for the home page: the same indexable head as Base, but without the global
 * landing and blog CSS, because the home owns its styles.
 */
type Props = Parameters<typeof SeoHead>[0];
---
<!doctype html>
<html lang={SITE.locale} style="color-scheme:light">
<head>
  <SeoHead {...Astro.props} />
</head>
<body>
  <Sprite />
  <slot />
</body>
</html>
